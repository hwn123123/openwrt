config wifi-device 'radio0'
	option type 'mac80211'
	option phy 'phy0'
	option country 'US'
	option band '5g'
	option channel '149'
	option htmode 'EHT80'
	option txpower '30'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'openwrt'
	option encryption 'sae'
	option key '1234567890'
	option ieee80211w '2'
