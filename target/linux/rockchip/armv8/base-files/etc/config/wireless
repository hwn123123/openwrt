config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/22000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option country 'US'
	option band '5g'
	option channel 'auto'
	option acs_exclude_dfs '1'
	list channels '36'
	list channels '40'
	list channels '44'
	list channels '48'
	list channels '149'
	list channels '153'
	list channels '157'
	list channels '161'
	option htmode 'HE80'
	option txpower '30'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'openwrt'
	option encryption 'sae'
	option key '1234567890'
	option ieee80211w '2'
