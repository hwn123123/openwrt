diff --git a/drivers/pwm/rk_pwm.c b/drivers/pwm/rk_pwm.c
index b51dee31..1b9d2632 100644
--- a/drivers/pwm/rk_pwm.c
+++ b/drivers/pwm/rk_pwm.c
@@ -16,11 +16,28 @@
 #include <linux/bitops.h>
 #include <power/regulator.h>
 
+#define RK_PWM_V4_ENABLE		0x04
+#define RK_PWM_V4_CTRL			0x0c
+#define RK_PWM_V4_PERIOD		0x10
+#define RK_PWM_V4_DUTY			0x14
+
+#define RK_PWM_V4_CLK_EN		BIT(0)
+#define RK_PWM_V4_PWM_EN		BIT(1)
+#define RK_PWM_V4_CTRL_UPDATE_EN	BIT(2)
+#define RK_PWM_V4_MODE_CONTINUOUS	BIT(0)
+#define RK_PWM_V4_DUTY_POSITIVE		BIT(2)
+#define RK_PWM_V4_INACTIVE_POSITIVE	BIT(3)
+#define RK_PWM_V4_POLARITY_MASK		GENMASK(3, 2)
+
+#define RK_PWM_V4_HIWORD_UPDATE(value, mask) \
+	((value) | ((mask) << 16))
+
 struct rockchip_pwm_data {
 	struct rockchip_pwm_regs regs;
 	unsigned int prescaler;
 	bool supports_polarity;
 	bool supports_lock;
+	bool version4;
 	u32 enable_conf;
 	u32 enable_conf_mask;
 };
@@ -35,6 +52,7 @@ struct rk_pwm_priv {
 static int rk_pwm_set_invert(struct udevice *dev, uint channel, bool polarity)
 {
 	struct rk_pwm_priv *priv = dev_get_priv(dev);
+	u32 value;
 
 	if (!priv->data->supports_polarity) {
 		debug("%s: Do not support polarity\n", __func__);
@@ -47,6 +65,14 @@ static int rk_pwm_set_invert(struct udevice *dev, uint channel, bool polarity)
 	else
 		priv->conf_polarity = PWM_DUTY_POSTIVE | PWM_INACTIVE_NEGATIVE;
 
+	if (priv->data->version4) {
+		value = polarity ? RK_PWM_V4_INACTIVE_POSITIVE :
+			RK_PWM_V4_DUTY_POSITIVE;
+		writel(RK_PWM_V4_HIWORD_UPDATE(value,
+					       RK_PWM_V4_POLARITY_MASK),
+		       priv->base + RK_PWM_V4_CTRL);
+	}
+
 	return 0;
 }
 
@@ -60,6 +86,23 @@ static int rk_pwm_set_config(struct udevice *dev, uint channel, uint period_ns,
 
 	debug("%s: period_ns=%u, duty_ns=%u\n", __func__, period_ns, duty_ns);
 
+	if (priv->data->version4) {
+		period = lldiv((uint64_t)priv->freq * period_ns, 1000000000);
+		duty = lldiv((uint64_t)priv->freq * duty_ns, 1000000000);
+
+		writel(period, priv->base + RK_PWM_V4_PERIOD);
+		writel(duty, priv->base + RK_PWM_V4_DUTY);
+		writel(RK_PWM_V4_HIWORD_UPDATE(RK_PWM_V4_MODE_CONTINUOUS,
+					       GENMASK(1, 0)),
+		       priv->base + RK_PWM_V4_CTRL);
+		writel(RK_PWM_V4_HIWORD_UPDATE(RK_PWM_V4_CTRL_UPDATE_EN,
+					       RK_PWM_V4_CTRL_UPDATE_EN),
+		       priv->base + RK_PWM_V4_ENABLE);
+
+		debug("%s: period=%lu, duty=%lu\n", __func__, period, duty);
+		return 0;
+	}
+
 	ctrl = readl(priv->base + regs->ctrl);
 	/*
 	 * Lock the period and duty of previous configuration, then
@@ -105,6 +148,15 @@ static int rk_pwm_set_enable(struct udevice *dev, uint channel, bool enable)
 
 	debug("%s: Enable '%s'\n", __func__, dev->name);
 
+	if (priv->data->version4) {
+		u32 mask = RK_PWM_V4_CLK_EN | RK_PWM_V4_PWM_EN;
+		u32 value = enable ? mask : 0;
+
+		writel(RK_PWM_V4_HIWORD_UPDATE(value, mask),
+		       priv->base + RK_PWM_V4_ENABLE);
+		return 0;
+	}
+
 	ctrl = readl(priv->base + regs->ctrl);
 	ctrl &= ~priv->data->enable_conf_mask;
 
@@ -198,10 +250,23 @@ static const struct rockchip_pwm_data pwm_data_v3 = {
 	.enable_conf_mask = GENMASK(2, 0) | BIT(5) | BIT(8),
 };
 
+static const struct rockchip_pwm_data pwm_data_v4 = {
+	.regs = {
+		.duty = RK_PWM_V4_DUTY,
+		.period = RK_PWM_V4_PERIOD,
+		.ctrl = RK_PWM_V4_CTRL,
+	},
+	.prescaler = 1,
+	.supports_polarity = true,
+	.supports_lock = true,
+	.version4 = true,
+};
+
 static const struct udevice_id rk_pwm_ids[] = {
 	{ .compatible = "rockchip,rk2928-pwm", .data = (ulong)&pwm_data_v1},
 	{ .compatible = "rockchip,rk3288-pwm", .data = (ulong)&pwm_data_v2},
 	{ .compatible = "rockchip,rk3328-pwm", .data = (ulong)&pwm_data_v3},
+	{ .compatible = "rockchip,rk3576-pwm", .data = (ulong)&pwm_data_v4},
 	{ }
 };
 
