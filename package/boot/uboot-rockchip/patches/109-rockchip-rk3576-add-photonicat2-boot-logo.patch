diff --git a/arch/arm/dts/rk3576-photonicat2.dts b/arch/arm/dts/rk3576-photonicat2.dts
new file mode 100644
index 00000000..c7031641
--- /dev/null
+++ b/arch/arm/dts/rk3576-photonicat2.dts
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/pwm/pwm.h>
+#include "rk3576.dtsi"
+
+/ {
+	model = "Ariaboard Photonicat 2";
+	compatible = "ariaboard,photonicat-2", "ariaboard,photonicat2",
+		     "rockchip,rk3576";
+
+	aliases {
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc;
+	};
+
+	chosen {
+		stdout-path = "serial0:1500000n8";
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm2_8ch_2 0 25000 PWM_POLARITY_INVERTED>;
+		default-brightness-level = <96>;
+	};
+
+	pwm2_8ch_2: pwm@2ade2000 {
+		compatible = "rockchip,rk3576-pwm";
+		reg = <0x0 0x2ade2000 0x0 0x1000>;
+		clocks = <&cru CLK_PWM2>, <&cru PCLK_PWM2>;
+		clock-names = "pwm", "pclk";
+		assigned-clocks = <&cru CLK_PWM2>;
+		assigned-clock-rates = <100000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pwm2m3_ch2>;
+		#pwm-cells = <3>;
+		status = "okay";
+	};
+};
+
+&sdhci {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	no-sd;
+	no-sdio;
+	non-removable;
+	status = "okay";
+};
+
+&sdmmc {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	disable-wp;
+	no-mmc;
+	no-sdio;
+	status = "okay";
+};
+
+&u2phy0 {
+	status = "okay";
+};
+
+&u2phy0_otg {
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-0 = <&uart0m0_xfer>;
+	status = "okay";
+};
+
+&usb_drd0_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&u2phy0_otg>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
+
+&spi1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi1m2_csn0 &pcat_spi1_pins>;
+	spi-max-frequency = <6000000>;
+
+	display@0 {
+		compatible = "ariaboard,pcat-spi-display";
+		reg = <0>;
+		spi-max-frequency = <6000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcat_lcd_pins>;
+		backlight = <&backlight>;
+		reset-gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_HIGH>;
+		ctrl-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&pinctrl {
+	pcat-spi1 {
+		pcat_spi1_pins: pcat-spi1-pins {
+			rockchip,pins =
+				<3 RK_PC7 10 &pcfg_pull_none>,
+				<3 RK_PC6 10 &pcfg_pull_none>;
+		};
+	};
+
+	pcat-lcd {
+		pcat_lcd_pins: pcat-lcd-pins {
+			rockchip,pins =
+				<3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>,
+				<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
diff --git a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
index 2e6bb38b..b501fbdb 100644
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -35,6 +35,10 @@
 #include <asm/arch-rockchip/periph.h>
 #include <power/regulator.h>
 
+#if IS_ENABLED(CONFIG_PCAT_SPI_DISPLAY)
+extern U_BOOT_DRIVER(pcat_spi_display);
+#endif
+
 #if IS_ENABLED(CONFIG_EFI_HAVE_CAPSULE_SUPPORT) && IS_ENABLED(CONFIG_EFI_PARTITION)
 
 #define DFU_ALT_BUF_LEN			SZ_1K
@@ -191,8 +195,20 @@ __weak int rk_board_late_init(void)
 
 int board_late_init(void)
 {
+#if IS_ENABLED(CONFIG_PCAT_SPI_DISPLAY)
+	struct udevice *panel;
+	int display_ret;
+#endif
+
 	setup_boot_mode();
 
+#if IS_ENABLED(CONFIG_PCAT_SPI_DISPLAY)
+	display_ret = uclass_get_device_by_driver(UCLASS_PANEL,
+					  DM_DRIVER_GET(pcat_spi_display), &panel);
+	if (display_ret)
+		log_warning("Photonicat 2 display unavailable: %d\n", display_ret);
+#endif
+
 #if IS_ENABLED(CONFIG_EFI_HAVE_CAPSULE_SUPPORT) && IS_ENABLED(CONFIG_EFI_PARTITION)
 	gpt_capsule_update_setup();
 #endif
