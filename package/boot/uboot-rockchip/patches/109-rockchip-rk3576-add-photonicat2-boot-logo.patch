+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Early boot logo support for the Photonicat 2 GC9307 SPI panel.
+ *
+ * The original driver was published by Photonicat for their RK3576 vendor
+ * U-Boot. This version uses current driver-model interfaces and keeps the
+ * exact vendor logo in a compact, lossless RLE representation.
+ */
+
+#include <backlight.h>
+#include <dm.h>
+#include <linux/errno.h>
+#include <linux/delay.h>
+#include <spi.h>
+#include <asm/gpio.h>
+
+#include "pcat-spi-display-logo.h"
+
+struct pcat_spi_display_priv {
+	struct spi_slave *spi;
+	struct udevice *backlight;
+	struct gpio_desc reset_gpio;
+	struct gpio_desc ctrl_gpio;
+	int ctrl_state;
+};
+
+static int pcat_spi_display_set_ctrl(struct pcat_spi_display_priv *priv,
+				     int state)
+{
+	int ret;
+
+	if (priv->ctrl_state == state)
+		return 0;
+
+	ret = dm_gpio_set_value(&priv->ctrl_gpio, state);
+	if (!ret)
+		priv->ctrl_state = state;
+
+	return ret;
+}
+
+static int pcat_spi_display_write(struct pcat_spi_display_priv *priv,
+				  bool data, const void *buf, size_t len)
+{
+	int ret;
+
+	ret = pcat_spi_display_set_ctrl(priv, data);
+	if (ret)
+		return ret;
+
+	return spi_xfer(priv->spi, len * 8, buf, NULL, SPI_XFER_ONCE);
+}
+
+static int pcat_spi_display_command(struct pcat_spi_display_priv *priv,
+				    u8 command)
+{
+	return pcat_spi_display_write(priv, false, &command, sizeof(command));
+}
+
+static int pcat_spi_display_data(struct pcat_spi_display_priv *priv,
+				 const void *buf, size_t len)
+{
+	return pcat_spi_display_write(priv, true, buf, len);
+}
+
+static int pcat_spi_display_show_logo(struct pcat_spi_display_priv *priv)
+{
+	static const u8 column[] = { 0x00, 0x22, 0x00, 0xcd };
+	static const u8 row[] = { 0x00, 0x00, 0x01, 0x3f };
+	u8 buffer[1024];
+	size_t buffered = 0;
+	size_t pixels = 0;
+	u8 value;
+	int ret;
+	uint i;
+
+	ret = dm_gpio_set_value(&priv->reset_gpio, 1);
+	if (ret)
+		return ret;
+	ret = dm_gpio_set_value(&priv->ctrl_gpio, 1);
+	if (ret)
+		return ret;
+	priv->ctrl_state = 1;
+
+	mdelay(5);
+	ret = dm_gpio_set_value(&priv->reset_gpio, 0);
+	if (ret)
+		return ret;
+	mdelay(10);
+	ret = dm_gpio_set_value(&priv->reset_gpio, 1);
+	if (ret)
+		return ret;
+	mdelay(10);
+
+	ret = pcat_spi_display_command(priv, 0x01); /* software reset */
+	if (ret)
+		return ret;
+	mdelay(10);
+	ret = pcat_spi_display_command(priv, 0x11); /* sleep out */
+	if (ret)
+		return ret;
+	mdelay(120);
+
+	ret = pcat_spi_display_command(priv, 0x3a); /* RGB565 */
+	if (ret)
+		return ret;
+	value = 0x55;
+	ret = pcat_spi_display_data(priv, &value, sizeof(value));
+	if (ret)
+		return ret;
+
+	ret = pcat_spi_display_command(priv, 0x36); /* memory direction */
+	if (ret)
+		return ret;
+	value = 0x40;
+	ret = pcat_spi_display_data(priv, &value, sizeof(value));
+	if (ret)
+		return ret;
+
+	ret = pcat_spi_display_command(priv, 0x2a);
+	if (ret)
+		return ret;
+	ret = pcat_spi_display_data(priv, column, sizeof(column));
+	if (ret)
+		return ret;
+	ret = pcat_spi_display_command(priv, 0x2b);
+	if (ret)
+		return ret;
+	ret = pcat_spi_display_data(priv, row, sizeof(row));
+	if (ret)
+		return ret;
+	ret = pcat_spi_display_command(priv, 0x2c);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(pcat_logo_runs); i++) {
+		u16 count = pcat_logo_runs[i].count;
+		u16 pixel = pcat_logo_runs[i].rgb565;
+
+		while (count--) {
+			buffer[buffered++] = pixel >> 8;
+			buffer[buffered++] = pixel & 0xff;
+			pixels++;
+
+			if (buffered == sizeof(buffer)) {
+				ret = pcat_spi_display_data(priv, buffer, buffered);
+				if (ret)
+					return ret;
+				buffered = 0;
+			}
+		}
+	}
+
+	if (pixels != PCAT_LOGO_WIDTH * PCAT_LOGO_HEIGHT)
+		return -EINVAL;
+	if (buffered) {
+		ret = pcat_spi_display_data(priv, buffer, buffered);
+		if (ret)
+			return ret;
+	}
+
+	return pcat_spi_display_command(priv, 0x29); /* display on */
+}
+
+static int pcat_spi_display_of_to_plat(struct udevice *dev)
+{
+	struct pcat_spi_display_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	priv->spi = dev_get_parent_priv(dev);
+	ret = uclass_get_device_by_phandle(UCLASS_PANEL_BACKLIGHT, dev,
+					   "backlight", &priv->backlight);
+	if (ret)
+		return ret;
+
+	ret = gpio_request_by_name(dev, "reset-gpios", 0, &priv->reset_gpio,
+				   GPIOD_IS_OUT);
+	if (ret)
+		return ret;
+
+	ret = gpio_request_by_name(dev, "ctrl-gpios", 0, &priv->ctrl_gpio,
+				   GPIOD_IS_OUT);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static int pcat_spi_display_probe(struct udevice *dev)
+{
+	struct pcat_spi_display_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = spi_claim_bus(priv->spi);
+	if (ret)
+		return ret;
+
+	priv->ctrl_state = -1;
+	ret = pcat_spi_display_show_logo(priv);
+	spi_release_bus(priv->spi);
+	if (ret)
+		return ret;
+
+	ret = backlight_enable(priv->backlight);
+	if (ret)
+		return ret;
+
+	printf("Photonicat 2 boot logo displayed\n");
+	return 0;
+}
+
+static const struct udevice_id pcat_spi_display_ids[] = {
+	{ .compatible = "ariaboard,pcat-spi-display" },
+	{ }
+};
+
+U_BOOT_DRIVER(pcat_spi_display) = {
+	.name = "pcat-spi-display",
+	.id = UCLASS_PANEL,
+	.of_match = pcat_spi_display_ids,
+	.of_to_plat = pcat_spi_display_of_to_plat,
+	.probe = pcat_spi_display_probe,
+	.priv_auto = sizeof(struct pcat_spi_display_priv),
+};
