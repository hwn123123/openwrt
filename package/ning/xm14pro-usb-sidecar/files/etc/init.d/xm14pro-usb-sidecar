#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
# Binder managers start at S57. Keep the hardware observer later than those
# managers and away from the S12 ConfigFS gadget owner.
START=65
STOP=39

ANDROID_ROOT=/usr/libexec/xm14pro-qwes/android-root
LAUNCHER=/usr/libexec/xm14pro-usb-sidecar/launcher
PERMISSIONS=/usr/libexec/xm14pro-usb-sidecar/apply-stock-permissions
FRAMEWORK_STATE_DIR=$ANDROID_ROOT/data/vendor/xm14pro-usb

manager_running() {
	local command="$1"

	ps w | awk -v command="$command" '
		index($0, command) && $0 !~ /awk -v command=/ { found = 1 }
		END { exit found ? 0 : 1 }
	'
}

wait_for_binder_managers() {
	local attempt=0

	while [ "$attempt" -lt 20 ]; do
		if manager_running '/system/bin/servicemanager' &&
		   manager_running '/system_ext/bin/hwservicemanager' &&
		   manager_running '/vendor/bin/vndservicemanager /dev/vndbinder'; then
			sleep 1
			manager_running '/system/bin/servicemanager' &&
			manager_running '/system_ext/bin/hwservicemanager' &&
			manager_running '/vendor/bin/vndservicemanager /dev/vndbinder'
			return $?
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

start_service() {
	local enabled

	config_load xm14usbcompat
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	# Reuse the existing stock Binder world. Do not create a second service
	# manager set and do not start Android init/property_service.
	/etc/init.d/xm14pro-binder-managers running ||
		/etc/init.d/xm14pro-binder-managers start
	wait_for_binder_managers || {
		logger -t xm14pro-usb-sidecar 'stock Binder managers are not ready'
		return 1
	}

	[ -x "$ANDROID_ROOT/vendor/bin/hw/android.hardware.usb-service.qti" ] || {
		logger -t xm14pro-usb-sidecar 'stock IUsb binary is missing'
		return 1
	}
	[ -r "$ANDROID_ROOT/vendor/lib64/android.hardware.usb-V1-ndk.so" ] || {
		logger -t xm14pro-usb-sidecar 'stock IUsb AIDL library is missing'
		return 1
	}
	[ -x "$ANDROID_ROOT/vendor/bin/xm14pro-usb-framework" ] || {
		logger -t xm14pro-usb-sidecar 'framework-side IUsb callback owner is missing'
		return 1
	}
	mkdir -p "$FRAMEWORK_STATE_DIR" || {
		logger -t xm14pro-usb-sidecar 'cannot create framework readiness directory'
		return 1
	}
	chown 1000:1000 "$FRAMEWORK_STATE_DIR"
	chmod 0750 "$FRAMEWORK_STATE_DIR"

	# Android starts IUsb before charger_pd has published Type-C. The real HAL
	# is designed to observe those nodes when they arrive, so start it now and
	# synchronize only the exact stock sysfs permissions in a separate one-shot
	# worker. No status node is ever fabricated by this package.
	procd_open_instance usb_hal
	procd_set_param command "$LAUNCHER" "$ANDROID_ROOT" port
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# HyperOS UsbPortManager registers IUsbCallback immediately after IUsb is
	# published.  Without that callback the Qualcomm HAL never starts its uevent
	# and bus-reset worker, even though the service process remains alive.  The
	# client publishes the current boot ID only after both Binder calls succeed;
	# the later ConfigFS service waits for that exact marker before binding UDC.
	procd_open_instance usb_framework
	procd_set_param command "$LAUNCHER" "$ANDROID_ROOT" framework
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance stock_permissions
	procd_set_param command "$PERMISSIONS"
	procd_set_param oneshot 1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xm14usbcompat
}
