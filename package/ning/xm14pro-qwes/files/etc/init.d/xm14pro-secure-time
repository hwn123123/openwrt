#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
START=10
STOP=02

ANDROID_ROOT=/usr/libexec/xm14pro-qwes/android-root
PERSIST_TARGET="$ANDROID_ROOT/mnt/vendor/persist"
ATS_TOD="$PERSIST_TARGET/time/ats_1"
STATE_DIR=/mnt/nwrt-data/time
STATE_FILE="$STATE_DIR/tod-offset-ms"
HELPER=/usr/libexec/xm14pro-qwes/secure-time

is_mounted() {
	grep -Fqs " $1 " /proc/mounts
}

mount_persist() {
	local source=/dev/block/by-name/persist

	is_mounted "$PERSIST_TARGET" && return 0
	[ -b "$source" ] || return 1
	mkdir -p "$PERSIST_TARGET"
	mount -t ext4 -o rw,nosuid,nodev,noatime "$source" "$PERSIST_TARGET"
}

restore_time() {
	mkdir -p "$STATE_DIR"
	mount_persist || logger -t xm14pro-secure-time \
		'persist is unavailable; trying the nwrt TOD offset only'
	"$HELPER" restore "$ATS_TOD" "$STATE_FILE"
}

start_service() {
	restore_time || logger -t xm14pro-secure-time \
		'could not restore a valid wall clock before Qualcomm services'

	procd_open_instance keeper
	procd_set_param command /usr/libexec/xm14pro-qwes/time-keeper "$STATE_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	"$HELPER" save "$STATE_FILE" >/dev/null 2>&1 || true
}
