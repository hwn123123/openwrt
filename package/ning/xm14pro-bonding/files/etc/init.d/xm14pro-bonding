#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=11

migrate_config() {
	local changed=0
	for option in server port key tunnel_local tunnel_gateway; do
		if uci -q get "xm14bonding.main.$option" >/dev/null; then
			uci -q delete "xm14bonding.main.$option"
			changed=1
		fi
	done
	if ! uci -q get xm14bonding.main.sim1_weight >/dev/null; then
		uci -q set xm14bonding.main.sim1_weight=1
		changed=1
	fi
	if ! uci -q get xm14bonding.main.sim2_weight >/dev/null; then
		uci -q set xm14bonding.main.sim2_weight=1
		changed=1
	fi
	[ "$changed" = 0 ] || uci -q commit xm14bonding
}

start_service() {
	local enabled
	migrate_config
	enabled="$(uci -q get xm14bonding.main.enabled)"
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/xm14pro-bonding/run
	procd_set_param respawn 15 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/xm14bonding
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xm14bonding
}
