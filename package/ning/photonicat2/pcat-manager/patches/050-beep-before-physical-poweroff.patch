+/* The PMU reports this only for a physical long press.  Play the same
+ * one-shot tone exposed by the native beeper control, then start the normal
+ * shutdown path.  Scheduled and web-triggered poweroffs stay unchanged. */
+static gboolean pcat_pmu_physical_poweroff_timeout(gpointer user_data)
+{
+    PCatPMUManagerData *pmu_data = (PCatPMUManagerData *)user_data;
+
+    pmu_data->shutdown_pending = FALSE;
+    pcat_pmu_poweroff_request(pmu_data);
+
+    return G_SOURCE_REMOVE;
+}
+
+static void pcat_pmu_physical_poweroff_request(PCatPMUManagerData *pmu_data)
+{
+    const guint16 tone_hz[] = {2700};
+    const guint16 tone_ms[] = {300};
+
+    if(pmu_data->shutdown_pending || pmu_data->shutdown_request)
+    {
+        return;
+    }
+
+    if(!pmu_data->beeper_state)
+    {
+        pcat_pmu_poweroff_request(pmu_data);
+        return;
+    }
+
+    pcat_pmu_manager_beeper_play(tone_hz, tone_ms,
+        G_N_ELEMENTS(tone_hz), FALSE);
+    pmu_data->shutdown_pending = TRUE;
+    g_timeout_add(300, pcat_pmu_physical_poweroff_timeout, pmu_data);
+}
