#!/bin/sh /etc/rc.common

USE_PROCD=1
# Start the panel before networking and the vendor web service.  The display
# has its own boot animation and its collectors tolerate unavailable data;
# waiting for pcat-manager-web here made the animation appear only after the
# whole system had finished booting.
START=01
STOP=00

start_service() {
	# Keep the panel dark while the daemon prepares fonts, collectors and SPI;
	# the daemon writes the first animation frame before enabling the backlight.
	[ -w /sys/class/backlight/backlight/brightness ] && echo 0 > /sys/class/backlight/backlight/brightness
	procd_open_instance
	# Do not wait for pcat-manager-web.  The display starts its welcome
	# animation immediately and refreshes live data as the backend appears.
	procd_set_param command /usr/bin/photonicat2_mini_display
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
