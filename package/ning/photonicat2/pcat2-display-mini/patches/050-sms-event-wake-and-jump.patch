+// showSmsPage refreshes the SMS images and then takes the LCD directly to
+// the first SMS page. Updating lastActivity also wakes a dimmed/off display;
+// it intentionally keeps the user's normal page rotation and timeout intact.
+func showSmsPage(c *fiber.Ctx) error {
+	configMutex.RLock()
+	showSMS := cfg.ShowSms
+	configMutex.RUnlock()
+	if !showSMS {
+		return c.Status(fiber.StatusConflict).JSON(fiber.Map{
+			"status": "disabled", "message": "SMS display is disabled",
+		})
+	}
+
+	lastActivityMu.Lock()
+	lastActivity = time.Now()
+	lastActivityMu.Unlock()
+
+	requestSmsDisplay()
+	return c.JSON(fiber.Map{"status": "accepted"})
+}
