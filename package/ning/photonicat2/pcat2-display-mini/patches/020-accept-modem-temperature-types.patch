+type StringOrIntMap string
+
+func (s *StringOrIntMap) UnmarshalJSON(data []byte) error {
+	var single string
+	if err := json.Unmarshal(data, &single); err == nil {
+		*s = StringOrIntMap(single)
+		return nil
+	}
+
+	var values map[string]int
+	if err := json.Unmarshal(data, &values); err != nil {
+		return err
+	}
+	encoded, err := json.Marshal(values)
+	if err != nil {
+		return err
+	}
+	*s = StringOrIntMap(encoded)
+	return nil
+}
