+// multiNetSpeedSampler gives every interface its own counter history. A
+// single netSpeedSampler resets its history when its interface changes, which
+// is correct for a failover but wrong when several ports are summed.
+type multiNetSpeedSampler struct {
+	mu       sync.Mutex
+	samplers map[string]*netSpeedSampler
+}
+
+func (s *multiNetSpeedSampler) sample(iface string) (NetworkSpeed, bool, error) {
+	s.mu.Lock()
+	if s.samplers == nil {
+		s.samplers = make(map[string]*netSpeedSampler)
+	}
+	sampler := s.samplers[iface]
+	if sampler == nil {
+		sampler = &netSpeedSampler{}
+		s.samplers[iface] = sampler
+	}
+	s.mu.Unlock()
+	return sampler.sample(iface)
+}
+
