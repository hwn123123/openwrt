#!/bin/sh /etc/rc.common

USE_PROCD=1
START=19
STOP=88

start_service() {
	config_load photonicat2
	local enabled onboard_wifi_enabled
	config_get_bool enabled main enabled 1
	if [ "$enabled" -eq 1 ]; then
		config_get_bool onboard_wifi_enabled main onboard_wifi_enabled 0
		/usr/libexec/photonicat2ctl onboard-wifi-boot-sync \
			"$onboard_wifi_enabled" >/dev/null 2>&1 || true
	fi
	# The AIC8800 default-off rfkill state is global to WLAN devices in the
	# kernel.  Restore the independent PCIe radio after syncing that gate and
	# before network (START=20), even when the optional daemon is disabled.
	/usr/libexec/photonicat2ctl pcie-wifi-boot-sync >/dev/null 2>&1 || true
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/photonicat2d
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger photonicat2
}

reload_service() {
	stop
	start
}

shutdown() {
	config_load photonicat2
	local enabled
	config_get_bool enabled main enabled 1
	if [ "$enabled" -eq 1 ] && [ -x /usr/libexec/photonicat2ctl ]; then
		/usr/libexec/photonicat2ctl beep-event shutdown >/dev/null 2>&1 || true
		sleep 1
	fi
	stop
}
