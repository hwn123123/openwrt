config core 'main'
	option enabled '1'
	option onboard_wifi_enabled '0'
	option cpu_powersave '0'
	option fan_mode 'smart_quiet'
	option fan_max '5'
	option led_mode 'on'
	option led_start '07:00'
	option led_end '23:00'
	option beeper_mode 'on'
	option beeper_start '08:00'
	option beeper_end '22:00'
	option beeper_custom '[{"hz":1047,"ms":160},{"hz":1319,"ms":160},{"hz":1568,"ms":180},{"hz":2093,"ms":320}]'
	option beeper_event_boot 'success'
	option beeper_event_shutdown 'down'
	option beeper_event_charging 'notify'
	option beeper_event_low_battery 'warning'
	option beeper_event_cellular 'chime'
	option beeper_event_lan 'short'
	option beeper_event_wan 'double'
	option beeper_event_wifi_start 'success'
	option beeper_event_wifi_client 'short'
	option history_enable '1'
	option history_interval '60'
	option history_keep '1440'
	option low_battery_enable '0'
	option low_battery_threshold '10'
	option idle_shutdown_enable '0'
	option idle_shutdown_minutes '30'
	option idle_battery_only '1'
