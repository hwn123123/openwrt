	json_file_boolean sms_route_query "$TELECOM_STATE" sms_route_query
	json_add_string sms_route_count "$(file_value "$TELECOM_STATE" sms_route_count)"
	json_add_string smsc_address "$(file_value "$SMSC_STATE" smsc_address)"
	json_add_string smsc_type "$(file_value "$SMSC_STATE" smsc_type)"
	json_file_boolean sms_uim_storage "$TELECOM_STATE" sms_uim_storage
	json_file_boolean sms_transfer_route "$TELECOM_STATE" sms_transfer_route
	json_file_boolean sms_storage_query "$TELECOM_STATE" sms_storage_query
	json_add_string sms_stored_total "$(file_value "$TELECOM_STATE" sms_stored_total)"
	json_add_string sms_unread_total "$(file_value "$TELECOM_STATE" sms_unread_total)"
	json_file_boolean voice_config_query "$TELECOM_STATE" voice_config_query
	if [ -r "$VOICE_STATE" ]; then json_add_boolean voice_call_query 1; else json_file_boolean voice_call_query "$TELECOM_STATE" voice_call_query; fi
	json_add_string active_call_count "$(call_value active_call_count)"
	json_add_string active_call_id "$(call_value active_call_id)"
	json_add_string active_call_state "$(call_value active_call_state)"
	json_add_string active_call_type "$(call_value active_call_type)"
	json_add_string active_call_direction "$(call_value active_call_direction)"
	json_add_string active_call_mode "$(call_value active_call_mode)"
	json_add_string active_call_number "$(call_value active_call_number)"
	json_add_string voice_domain "$(file_value "$TELECOM_STATE" voice_domain)"
	json_add_string voice_privacy "$(file_value "$TELECOM_STATE" voice_privacy)"
	json_add_string tty_mode "$(file_value "$TELECOM_STATE" tty_mode)"
	json_add_string auto_answer "$(file_value "$TELECOM_STATE" auto_answer)"
	json_file_boolean ims_registration_query "$TELECOM_STATE" ims_registration_query
	json_add_string ims_registration "$(file_value "$TELECOM_STATE" ims_registration)"
	json_add_string ims_technology "$(file_value "$TELECOM_STATE" ims_technology)"
	json_add_string ims_sms_status "$(file_value "$TELECOM_STATE" ims_sms_status)"
	json_add_string ims_sms_technology "$(file_value "$TELECOM_STATE" ims_sms_technology)"
	json_add_string ims_voice_status "$(file_value "$TELECOM_STATE" ims_voice_status)"
	json_add_string ims_voice_technology "$(file_value "$TELECOM_STATE" ims_voice_technology)"
	json_add_string ims_video_status "$(file_value "$TELECOM_STATE" ims_video_status)"
	json_add_string ims_video_technology "$(file_value "$TELECOM_STATE" ims_video_technology)"
	json_add_string ims_ut_status "$(file_value "$TELECOM_STATE" ims_ut_status)"
	json_add_string ims_ut_technology "$(file_value "$TELECOM_STATE" ims_ut_technology)"
	json_add_string physical_sim_slots "$(file_value "$TELECOM_STATE" physical_sim_slots)"
	json_file_boolean esim_supported "$TELECOM_STATE" esim_supported
	case "$autostart" in
		true) json_add_boolean interface_autostart 1 ;;
		false) json_add_boolean interface_autostart 0 ;;
		*) json_add_null interface_autostart ;;
	esac
	json_add_string interface "$interface"
	json_add_string ipv4 "$address"
	json_add_string ipv6 "$address6"
