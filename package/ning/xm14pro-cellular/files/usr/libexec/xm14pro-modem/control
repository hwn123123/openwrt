		1) json_add_boolean airplane_mode 1 ;;
		0) json_add_boolean airplane_mode 0 ;;
		*) json_add_null airplane_mode ;;
	esac
	case "$up" in
		true) json_add_boolean connected 1 ;;
		false) json_add_boolean connected 0 ;;
		*) json_add_null connected ;;
	esac
	case "$available" in
		true) json_add_boolean network_available 1 ;;
		false) json_add_boolean network_available 0 ;;
