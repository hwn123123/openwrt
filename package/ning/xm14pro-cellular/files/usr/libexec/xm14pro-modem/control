	json_add_string carrier_aggregation_capability "$(file_value "$RADIO_STATE" carrier_aggregation_capability)"
	json_add_string carrier_aggregation_max_sub6_cc "$(file_value "$RADIO_STATE" carrier_aggregation_max_sub6_cc)"
