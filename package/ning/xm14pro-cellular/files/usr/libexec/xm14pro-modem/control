	json_add_string ipv6_prefix "$prefix6"
	json_add_string dns_servers "$dns"
	json_add_string mtu "$mtu"
	json_add_string rx_bytes "$rx_bytes"
	json_add_string tx_bytes "$tx_bytes"
	json_add_string rx_packets "$rx_packets"
	json_add_string tx_packets "$tx_packets"
	json_add_string rx_errors "$rx_errors"
	json_add_string tx_errors "$tx_errors"
	json_add_string rx_dropped "$rx_dropped"
	json_add_string tx_dropped "$tx_dropped"
	json_int_or_null cpu_usage_percent "$cpu_usage"
	json_int_or_null cpu_cores "$cpu_cores"
	json_add_string load_1m "$load1"
