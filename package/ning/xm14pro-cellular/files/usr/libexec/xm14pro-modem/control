		1) json_add_string apn "$(uci_value sim1_apn)" ;;
		2) json_add_string apn "$(uci_value sim2_apn)" ;;
		*) json_add_string apn "" ;;
	esac
	json_add_string runtime_apn "$runtime_apn"
