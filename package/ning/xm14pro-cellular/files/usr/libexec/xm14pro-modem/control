#!/bin/sh

# Single, phone-specific control surface used by the mobile-network WebUI.
# Normal status reads only cached/system state.  Direct QMI access is reserved
# for an explicit refresh action so browser polling cannot compete with
# ModemManager for the Xiaomi modem's QRTR services.

. /usr/share/libubox/jshn.sh

TAG=xm14-mobile-api
STATE_ROOT=/var/run/xm14pro
DSI_STATE=$STATE_ROOT/dsi-cellular.state
DSI_ERROR=$STATE_ROOT/dsi-cellular.error
UIM_STATE=$STATE_ROOT/uim-state
RADIO_STATE=$STATE_ROOT/radio-state
TELECOM_STATE=$STATE_ROOT/telecom-state
VOICE_STATE=$STATE_ROOT/voice-state
SMSC_STATE=$STATE_ROOT/smsc-state
IMS_AIDL_STATE=$STATE_ROOT/ims-aidl-state
AIRPLANE_STATE=$STATE_ROOT/airplane-mode
DATA_SWITCH_FILE=$STATE_ROOT/data-slot-switching
ANDROID_COMPAT_ROOT=/usr/libexec/xm14pro-qwes/android-root
DELIVERY_ROOT=$ANDROID_COMPAT_ROOT/data/vendor/radio/ims-client
IMS_CALL_STATE=$DELIVERY_ROOT/call-state
CALL_HISTORY=/var/lib/xm14pro/calls
CALL_ACTION=$STATE_ROOT/call-local-action
MESSAGE_STATE=/var/lib/xm14pro/sms-state
SIM_CACHE=/var/lib/xm14pro/sms
TELEPHONY_LAUNCHER=/usr/libexec/xm14pro-telephony/launcher
RADIO_SMS_CLIENT=$ANDROID_COMPAT_ROOT/vendor/bin/xm14pro-radio-sms
AUDIO_CONTROL=/usr/libexec/xm14pro-audio/control
DDS_CONTROL=/usr/libexec/xm14pro-nicm/dds-control-launcher

fail() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$*"
	json_dump
	exit 1
}

uci_value() {
	uci -q get "xm14cellular.main.$1" 2>/dev/null
}

modem_id() {
	mmcli -L 2>/dev/null | sed -n 's#.*Modem/\([0-9][0-9]*\).*#\1#p' | head -n 1
}

mm_value() {
	local raw="$1" key="$2"
	printf '%s\n' "$raw" | sed -n "s/^[[:space:]]*$key[[:space:]]*:[[:space:]]*//p" | head -n 1 | sed "s/^'//;s/'$//"
}

network_status() {
	ubus call network.interface.cellular status 2>/dev/null || printf '%s\n' '{}'
}

file_value() {
	local file="$1" key="$2"
	[ -r "$file" ] || return 0
	sed -n "s/^$key=//p" "$file" | tail -n 1
}

call_value() {
	local value
	if [ "$(file_value "$IMS_CALL_STATE" active_call_count)" = 1 ]; then
		case "$1" in
			active_call_count|active_call_id|active_call_state|active_call_type|active_call_direction|active_call_mode|active_call_number|active_call_slot)
				file_value "$IMS_CALL_STATE" "$1"
				return
				;;
		esac
	fi
	value="$(file_value "$VOICE_STATE" "$1")"
	[ -n "$value" ] || value="$(file_value "$TELECOM_STATE" "$1")"
	printf '%s\n' "$value"
}

mark_call_action() {
	local call_id="$1" state action temporary
	state="$(call_value active_call_state)"
	case "$state" in
		incoming|waiting) action=rejected ;;
		originating|alerting) action=cancelled ;;
		*) action=ended ;;
	esac
	mkdir -p "$STATE_ROOT"
	temporary="$CALL_ACTION.$$"
	printf 'call_id=%s\naction=%s\nepoch=%s\n' "$call_id" "$action" "$(date +%s)" > "$temporary" &&
		mv "$temporary" "$CALL_ACTION"
}

json_value() {
	printf '%s\n' "$1" | jsonfilter -e "$2" 2>/dev/null | head -n 1
}

ims_aidl_value() {
	local expression="$1"
	[ -r "$IMS_AIDL_STATE" ] || return 0
	jsonfilter -i "$IMS_AIDL_STATE" -e "$expression" 2>/dev/null | head -n 1
}

ims_aidl_slot_value() {
	local slot="$1" key="$2" value
	[ -r "$IMS_AIDL_STATE" ] || return 0
	value="$(jsonfilter -i "$IMS_AIDL_STATE" -e "@.slots.$slot.$key" 2>/dev/null | head -n 1)"
	if [ -z "$value" ] && [ "$(ims_aidl_value '@.slot')" = "$slot" ]; then
		value="$(ims_aidl_value "@.$key")"
	fi
	printf '%s\n' "$value"
}

ims_aidl_ready() {
	local subscription slot="$1" boot_id
	if [ -z "$slot" ]; then
		subscription="$(cat "$STATE_ROOT/qmi-subscription" 2>/dev/null)"
		case "$subscription" in
			0) slot=slot1 ;;
			1) slot=slot2 ;;
			*) return 1 ;;
		esac
	fi
	boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
	[ -n "$boot_id" ] &&
	[ "$(ims_aidl_value '@.boot_id')" = "$boot_id" ] &&
	[ "$(ims_aidl_slot_value "$slot" ready)" = true ] &&
	[ "$(ims_aidl_slot_value "$slot" sms_format)" = 3gpp ] &&
	[ "$(ims_aidl_slot_value "$slot" registration_error)" = 1 ] &&
	[ "$(ims_aidl_slot_value "$slot" registration_state)" = 1 ] &&
	[ "$(ims_aidl_slot_value "$slot" service_error)" = 1 ] &&
	[ "$(ims_aidl_slot_value "$slot" sms_service_ready)" = true ]
}

selected_phone_slot() {
	local kind="$1" configured subscription slot ready_key
	configured="$(uci_value "${kind}_slot")"
	case "$configured" in
		1) slot=slot1; ready_key=slot1_ready ;;
		2) slot=slot2; ready_key=slot2_ready ;;
		auto|'')
			subscription="$(cat "$STATE_ROOT/qmi-subscription" 2>/dev/null)"
			case "$subscription" in
				0) slot=slot1; ready_key=slot1_ready ;;
				1) slot=slot2; ready_key=slot2_ready ;;
				*) return 1 ;;
			esac
			if [ "$(file_value "$UIM_STATE" "$ready_key")" != 1 ] || ! ims_aidl_ready "$slot"; then
				case "$slot" in
					slot1) slot=slot2; ready_key=slot2_ready ;;
					slot2) slot=slot1; ready_key=slot1_ready ;;
				esac
			fi
			;;
		*) return 1 ;;
	esac
	[ "$(file_value "$UIM_STATE" "$ready_key")" = 1 ] || return 1
	printf '%s\n' "$slot"
}

join_lines() {
	awk 'NF { if (out != "") out = out ", "; out = out $0 } END { print out }'
}

command_running() {
	ps w 2>/dev/null | awk -v needle="$1" 'index($0, needle) && !index($0, "awk -v needle=") { found = 1 } END { exit !found }'
}

qrtr_has() {
	printf '%s\n' "$1" | awk -v service="$2" '$1 == service && $4 == 0 { found = 1 } END { exit !found }'
}

mss_state() {
	local path name
	for path in /sys/class/remoteproc/remoteproc*; do
		[ -d "$path" ] || continue
		name="$(cat "$path/name" 2>/dev/null)"
		case "$name" in *mss*) cat "$path/state" 2>/dev/null; return ;; esac
	done
}

link_is_up() {
	local dev="$1"
	[ -n "$dev" ] && ip link show dev "$dev" 2>/dev/null | grep -q '<[^>]*UP[^>]*>'
}

network_address() {
	local status="$1"
	json_value "$status" '@["ipv4-address"][0].address'
}

network_device() {
	local status="$1" value
	value="$(json_value "$status" '@.data.device')"
	[ -n "$value" ] || value="$(json_value "$status" '@.l3_device')"
	printf '%s\n' "$value"
}

json_file_boolean() {
	local name="$1" file="$2" key="$3" value
	value="$(file_value "$file" "$key")"
	case "$value" in
		1) json_add_boolean "$name" 1 ;;
		0) json_add_boolean "$name" 0 ;;
		*) json_add_null "$name" ;;
	esac
}

json_int_or_null() {
	local name="$1" value="$2"
	case "$value" in
		''|*[!0-9]*) json_add_null "$name" ;;
		*) json_add_int "$name" "$value" ;;
	esac
}

thermal_named_c() {
	local wanted="$1" path type value
	for path in /sys/class/thermal/thermal_zone*; do
		[ -r "$path/type" ] && [ -r "$path/temp" ] || continue
		IFS= read -r type < "$path/type" || continue
		[ "$type" = "$wanted" ] || continue
		IFS= read -r value < "$path/temp" || return 0
		case "$value" in ''|*[!0-9-]*) return 0 ;; esac
		[ "$value" -ge 0 ] 2>/dev/null && [ "$value" -le 200000 ] 2>/dev/null &&
			awk -v value="$value" 'BEGIN { printf "%.1f", value / 1000 }'
		return 0
	done
}

thermal_cached_c() {
	local key="$1" sensor="$2" cache="/tmp/xm14pro-${1}-temperature" now saved value
	now="$(date +%s)"
	if [ -r "$cache" ]; then
		read -r saved value < "$cache"
		if [ -n "$saved" ] && [ -n "$value" ] &&
		   [ $((now - saved)) -lt 10 ] 2>/dev/null; then
			printf '%s' "$value"
			return 0
		fi
	fi
	value="$(thermal_named_c "$sensor")"
	[ -n "$value" ] || return 0
	printf '%s %s\n' "$now" "$value" > "$cache"
	printf '%s' "$value"
}

cpu_usage_percent() {
	local cache=/tmp/xm14pro-cpu-stat previous current total1 idle1 total2 idle2 delta_total delta_idle
	current="$(awk '/^cpu / { total = 0; for (i = 2; i <= NF; i++) total += $i; print total, $5 + $6; exit }' /proc/stat 2>/dev/null)"
	previous="$(cat "$cache" 2>/dev/null)"
	printf '%s\n' "$current" > "$cache"
	[ -n "$previous" ] && [ -n "$current" ] || return 0
	set -- $previous
	total1="$1"; idle1="$2"
	set -- $current
	total2="$1"; idle2="$2"
	delta_total=$((total2 - total1))
	delta_idle=$((idle2 - idle1))
	[ "$delta_total" -gt 0 ] 2>/dev/null || return 0
	awk -v total="$delta_total" -v idle="$delta_idle" 'BEGIN { value = 100 * (total - idle) / total; if (value < 0) value = 0; if (value > 100) value = 100; printf "%.0f", value }'
}

status_json() {
	local id mm net up pending available autostart address address6 gateway gateway6 prefix prefix6 dns
	local system_uptime session_uptime power interface runtime_apn qrtr qrtr_count remoteproc modem_present modem_state registration
	local subscription session_subscription active_slot sim_ready airplane dsi_error rx_bytes tx_bytes rx_packets tx_packets rx_errors tx_errors rx_dropped tx_dropped mtu
	local wifi_net wifi_iface wifi_up wifi_ip wifi_clients wifi_enabled wifi_country wifi_profile
	local usb_net usb_mode usb_udc usb_udc_path usb_up usb_ip cpe_enabled cpe_active ip_forward
	local mm_state mm_registration access operator_name operator_code
	local cpu_usage cpu_cores load1 load5 load15 mem_total mem_available mem_used mem_usage
	local cpu_temp modem_temp battery_temp imei imei_sv meid own_numbers
	local storage_total storage_used storage_available storage_usage storage_fs kernel_release architecture hostname slot_suffix audio_cards voice_bridge
	local audio_state audio_active audio_route audio_muted audio_volume active_count active_state voice_slot sms_receive_slot selected_voice_slot
	id="$(modem_id)"
	mm=
	[ -z "$id" ] || mm="$(mmcli -m "$id" -K 2>/dev/null)"
	net="$(network_status)"
	up="$(json_value "$net" '@.up')"
	pending="$(json_value "$net" '@.pending')"
	available="$(json_value "$net" '@.available')"
	autostart="$(json_value "$net" '@.autostart')"
	interface="$(json_value "$net" '@.data.device')"
	address="$(json_value "$net" '@.data.ipv4_address')"
	address6="$(json_value "$net" '@.data.ipv6_address')"
	gateway="$(json_value "$net" '@.data.ipv4_gateway')"
	gateway6="$(json_value "$net" '@.data.ipv6_gateway')"
	prefix="$(json_value "$net" '@.data.ipv4_prefix')"
	prefix6="$(json_value "$net" '@.data.ipv6_prefix')"
	[ -n "$interface" ] || interface="$(file_value "$DSI_STATE" device)"
	[ -n "$address" ] || address="$(file_value "$DSI_STATE" ipv4_address)"
	[ -n "$address6" ] || address6="$(file_value "$DSI_STATE" ipv6_address)"
	[ -n "$gateway" ] || gateway="$(file_value "$DSI_STATE" ipv4_gateway)"
	[ -n "$gateway6" ] || gateway6="$(file_value "$DSI_STATE" ipv6_gateway)"
	[ -n "$prefix" ] || prefix="$(file_value "$DSI_STATE" ipv4_prefix)"
	[ -n "$prefix6" ] || prefix6="$(file_value "$DSI_STATE" ipv6_prefix)"
	dns="$(printf '%s\n' "$net" | jsonfilter -e '@["dns-server"][@]' 2>/dev/null | join_lines)"
	[ -n "$dns" ] || dns="$(for key in ipv4_dns1 ipv4_dns2 ipv6_dns1 ipv6_dns2; do file_value "$DSI_STATE" "$key"; done | join_lines)"
	runtime_apn="$(uci -q get network.cellular.apn)"
	[ -n "$runtime_apn" ] || runtime_apn="$(sed -n 's/^apn=//p' "$STATE_ROOT/dsi-cellular.log" 2>/dev/null | tail -n 1)"
	system_uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
	session_uptime="$(json_value "$net" '@.uptime')"
	power="$(mm_value "$mm" 'modem.generic.power-state')"
	mm_state="$(mm_value "$mm" 'modem.generic.state')"
	mm_registration="$(mm_value "$mm" 'modem.3gpp.registration-state')"
	access="$(mm_value "$mm" 'modem.generic.access-technologies')"
	[ -n "$access" ] || access="$(file_value "$RADIO_STATE" access_technologies)"
	operator_name="$(mm_value "$mm" 'modem.3gpp.operator-name')"
	[ -n "$operator_name" ] || operator_name="$(file_value "$RADIO_STATE" operator_name)"
	operator_code="$(mm_value "$mm" 'modem.3gpp.operator-code')"
	[ -n "$operator_code" ] || operator_code="$(file_value "$RADIO_STATE" operator_code)"
	qrtr="$(qrtr-lookup 2>/dev/null)"
	qrtr_count="$(printf '%s\n' "$qrtr" | awk 'NF && $1 ~ /^[0-9]+$/ { n++ } END { print n + 0 }')"
	remoteproc="$(mss_state)"
	modem_present=0
	if [ "$remoteproc" = running ] && qrtr_has "$qrtr" 2; then modem_present=1; fi
	if [ -n "$mm_state" ]; then modem_state="$mm_state"
	elif [ "$up" = true ]; then modem_state=connected
	elif [ "$pending" = true ]; then modem_state=connecting
	elif [ "$modem_present" = 1 ]; then modem_state=ready
	else modem_state=unavailable
	fi
	if [ -n "$mm_registration" ]; then registration="$mm_registration"
	elif [ "$up" = true ]; then registration=attached
	elif [ -n "$(file_value "$RADIO_STATE" nas_registration_state)" ]; then registration="$(file_value "$RADIO_STATE" nas_registration_state)"
	else registration=
	fi
	subscription="$(cat "$STATE_ROOT/qmi-subscription" 2>/dev/null)"
	session_subscription="$(file_value "$DSI_STATE" qmi_subscription)"
	# The DSI subscription is the authoritative live data selection. The UIM
	# monitor follows it, but its cached file can lag a runtime DDS switch.
	[ "$up" != true ] || [ -z "$session_subscription" ] || subscription="$session_subscription"
	case "$subscription" in
		0) active_slot=1 ;;
		1) active_slot=2 ;;
		*) active_slot="$(file_value "$UIM_STATE" active_data_slot)" ;;
	esac
	sim_ready=0
	[ "$up" = true ] && [ -n "$active_slot" ] && sim_ready=1
	airplane="$(cat "$AIRPLANE_STATE" 2>/dev/null)"
	if [ "$up" = true ]; then airplane=0
	elif [ -n "$power" ]; then
		case "$power" in off|low-power) airplane=1 ;; on) airplane=0 ;; esac
	fi
	dsi_error="$(cat "$DSI_ERROR" 2>/dev/null)"
	rx_bytes="$(cat "/sys/class/net/$interface/statistics/rx_bytes" 2>/dev/null)"
	tx_bytes="$(cat "/sys/class/net/$interface/statistics/tx_bytes" 2>/dev/null)"
	rx_packets="$(cat "/sys/class/net/$interface/statistics/rx_packets" 2>/dev/null)"
	tx_packets="$(cat "/sys/class/net/$interface/statistics/tx_packets" 2>/dev/null)"
	rx_errors="$(cat "/sys/class/net/$interface/statistics/rx_errors" 2>/dev/null)"
	tx_errors="$(cat "/sys/class/net/$interface/statistics/tx_errors" 2>/dev/null)"
	rx_dropped="$(cat "/sys/class/net/$interface/statistics/rx_dropped" 2>/dev/null)"
	tx_dropped="$(cat "/sys/class/net/$interface/statistics/tx_dropped" 2>/dev/null)"
	mtu="$(cat "/sys/class/net/$interface/mtu" 2>/dev/null)"
	cpu_usage="$(cpu_usage_percent)"
	cpu_cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
	set -- $(cat /proc/loadavg 2>/dev/null)
	load1="$1"; load5="$2"; load15="$3"
	mem_total="$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null)"
	mem_available="$(awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo 2>/dev/null)"
	if [ -n "$mem_total" ] && [ -n "$mem_available" ] && [ "$mem_total" -gt 0 ] 2>/dev/null; then
		mem_used=$((mem_total - mem_available))
		mem_usage="$(awk -v used="$mem_used" -v total="$mem_total" 'BEGIN { printf "%.0f", 100 * used / total }')"
	fi
	# Dedicated board sensors are real hardware readings.  Avoid sweeping every
	# TSENS zone on every two-second UI refresh: Xiaomi's downstream minidump
	# hook logs an error on each such read and creates thousands of short-lived
	# processes per boot.
	cpu_temp="$(thermal_cached_c cpu cpu_therm)"
	modem_temp="$(thermal_cached_c modem mdmss-0)"
	battery_temp="$(cat /sys/class/power_supply/battery/temp 2>/dev/null)"
	case "$battery_temp" in
		''|*[!0-9-]*) battery_temp= ;;
		*) battery_temp="$(awk -v value="$battery_temp" 'BEGIN { printf "%.1f", value / 10 }')" ;;
	esac
	set -- $(df -kP /mnt/nwrt-data 2>/dev/null | awk 'NR == 2 { gsub(/%/, "", $5); print $2, $3, $4, $5 }')
	storage_total="$1"; storage_used="$2"; storage_available="$3"; storage_usage="$4"
	storage_fs="$(awk '$2 == "/mnt/nwrt-data" { print $3; exit }' /proc/mounts 2>/dev/null)"
	kernel_release="$(uname -r 2>/dev/null)"
	architecture="$(uname -m 2>/dev/null)"
	hostname="$(cat /proc/sys/kernel/hostname 2>/dev/null)"
	slot_suffix="$(sed -n 's/.*androidboot.slot_suffix=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)"
	audio_cards="$(awk '/^[[:space:]]*[0-9]+[[:space:]]+\[/ { count++ } END { print count + 0 }' /proc/asound/cards 2>/dev/null)"
	voice_bridge=0
	if [ -x "$AUDIO_CONTROL" ] && [ -S /dev/socket/xm14pro_audio_control ]; then
		audio_state="$($AUDIO_CONTROL status 2>/dev/null)"
		[ "$(json_value "$audio_state" '@.voice_capable')" = true ] && voice_bridge=1
		active_count="$(call_value active_call_count)"
		active_state="$(call_value active_call_state)"
		audio_active="$(json_value "$audio_state" '@.voice_active')"
		# Reconcile PAL after a remote hang-up, and after an incoming call was
		# answered while no browser action was pending.
		if [ "${active_count:-0}" = 0 ] && [ "$audio_active" = true ]; then
			$AUDIO_CONTROL call-stop >/dev/null 2>&1
			audio_state="$($AUDIO_CONTROL status 2>/dev/null)"
		elif [ "$active_state" = conversation ] && [ "$audio_active" != true ]; then
			voice_slot="$(call_value active_call_slot)"
			case "$voice_slot" in slot1|slot2) ;; *) voice_slot="$(selected_phone_slot voice 2>/dev/null)" ;; esac
			$AUDIO_CONTROL call-start earpiece "${voice_slot#slot}" >/dev/null 2>&1
			audio_state="$($AUDIO_CONTROL status 2>/dev/null)"
		fi
		audio_active="$(json_value "$audio_state" '@.voice_active')"
		audio_route="$(json_value "$audio_state" '@.voice_route')"
		audio_muted="$(json_value "$audio_state" '@.mic_muted')"
		audio_volume="$(json_value "$audio_state" '@.call_volume')"
	fi
	selected_voice_slot="$(selected_phone_slot voice 2>/dev/null)"
	sms_receive_slot="$(selected_phone_slot sms 2>/dev/null)"
	imei="$(mm_value "$mm" 'modem.3gpp.imei')"
	[ -n "$imei" ] || imei="$(file_value "$TELECOM_STATE" imei)"
	[ -n "$imei" ] || imei="$(file_value "$RADIO_STATE" imei)"
	imei_sv="$(file_value "$TELECOM_STATE" imei_sv)"
	[ -n "$imei_sv" ] || imei_sv="$(file_value "$RADIO_STATE" imei_sv)"
	meid="$(file_value "$TELECOM_STATE" meid)"
	[ -n "$meid" ] || meid="$(file_value "$RADIO_STATE" meid)"
	own_numbers="$(mm_value "$mm" 'modem.generic.own-numbers.value[1]')"

	wifi_net="$(ubus call network.interface.wifi_lan status 2>/dev/null || printf '%s\n' '{}')"
	wifi_iface="$(uci -q get wireless.nwrt_5g.ifname)"
	[ -n "$wifi_iface" ] || [ ! -e /sys/class/net/nwrt-ap ] || wifi_iface=nwrt-ap
	wifi_up=0; link_is_up "$wifi_iface" && wifi_up=1
	wifi_ip="$(network_address "$wifi_net")"
	# hostapd owns the association table and exposes it without asking the
	# downstream WLAN driver to dump one non-existent peer past the last entry.
	wifi_clients="$(ubus call "hostapd.$wifi_iface" get_clients 2>/dev/null |
		jsonfilter -e '@.clients.*.authorized' 2>/dev/null |
		awk '$1 == "true" { n++ } END { print n + 0 }')"
	wifi_enabled="$(uci -q get xm14wifi.main.enabled)"
	wifi_country="$(uci -q get xm14wifi.main.country)"
	wifi_profile="$(uci -q get xm14wifi.main.profile)"

	usb_net="$(ubus call network.interface.usb_lan status 2>/dev/null || printf '%s\n' '{}')"
	usb_mode="$(uci -q get xm14usb.main.mode)"
	usb_udc="$(cat /sys/kernel/config/usb_gadget/nwrt/UDC 2>/dev/null)"
	# The stock Xiaomi USB compatibility layer binds the gadget in the kernel
	# and does not create the former /config/usb_gadget/nwrt tree.  Report the
	# active UDC from sysfs, but determine a usable USB data connection from
	# netifd plus the usb0 carrier.  This is status-only and does not alter the
	# stock gadget or OpenWrt network setup.
	if [ -z "$usb_udc" ]; then
		for usb_udc_path in /sys/class/udc/*; do
			[ -e "$usb_udc_path" ] || continue
			usb_udc="${usb_udc_path##*/}"
			break
		done
	fi
	usb_up=0
	if [ "$usb_mode" != charge_only ] &&
	   [ "$(json_value "$usb_net" '@.up')" = true ] &&
	   link_is_up usb0 && [ "$(cat /sys/class/net/usb0/carrier 2>/dev/null)" = 1 ]; then
		usb_up=1
	fi
	usb_ip="$(network_address "$usb_net")"

	cpe_enabled="$(uci -q get xm14cpe.main.enabled)"
	ip_forward="$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)"
	cpe_active=0
	if [ "$cpe_enabled" != 0 ] && [ "$ip_forward" = 1 ] && [ -n "$interface" ] &&
	   iptables -w 1 -t nat -C XMCPE_NAT -o "$interface" -j MASQUERADE >/dev/null 2>&1; then
		cpe_active=1
	fi

	json_init
	json_add_boolean ok 1
	json_add_string backend "xiaomi-stock-dsi"
	json_add_string modem_id "${id:-}"
	json_add_boolean modem_available "$modem_present"
	json_add_string modem_state "$modem_state"
	json_add_string remoteproc_state "$remoteproc"
	json_add_string power_state "$power"
	json_add_string access_technologies "$access"
	json_add_string signal_quality "$(mm_value "$mm" 'modem.generic.signal-quality.value')"
	json_add_string operator_name "$operator_name"
	json_add_string operator_code "$operator_code"
	json_add_string registration_state "$registration"
	json_add_string nas_registration_state "$(file_value "$RADIO_STATE" nas_registration_state)"
	json_add_string imei "$imei"
	json_add_string imei_sv "$imei_sv"
	json_add_string meid "$meid"
	json_add_string esn "$(file_value "$TELECOM_STATE" esn)"
	json_add_string own_numbers "$own_numbers"
	json_add_string modem_manufacturer "$(file_value "$TELECOM_STATE" modem_manufacturer)"
	json_add_string modem_model "$(file_value "$TELECOM_STATE" modem_model)"
	json_add_string modem_revision "$(file_value "$TELECOM_STATE" modem_revision)"
	json_add_string modem_hardware_revision "$(file_value "$TELECOM_STATE" modem_hardware_revision)"
	json_add_string modem_software_version "$(file_value "$TELECOM_STATE" modem_software_version)"
	json_add_string modem_operating_mode "$(file_value "$TELECOM_STATE" modem_operating_mode)"
	json_add_string modem_hardware_restricted "$(file_value "$TELECOM_STATE" modem_hardware_restricted)"
	json_add_string modem_power_source "$(file_value "$TELECOM_STATE" modem_power_source)"
	json_add_string max_tx_rate "$(file_value "$TELECOM_STATE" max_tx_rate)"
	json_add_string max_rx_rate "$(file_value "$TELECOM_STATE" max_rx_rate)"
