	json_int_or_null storage_usage_percent "$storage_usage"
	json_add_string storage_filesystem "$storage_fs"
	json_add_string kernel_release "$kernel_release"
	json_add_string architecture "$architecture"
	json_add_string hostname "$hostname"
	json_add_string boot_slot "$slot_suffix"
	json_add_int audio_card_count "${audio_cards:-0}"
	json_add_boolean voice_listener_running "$(command_running 'xm14pro-telephony voice-listen' && echo 1 || echo 0)"
	json_add_boolean voice_audio_bridge "$voice_bridge"
