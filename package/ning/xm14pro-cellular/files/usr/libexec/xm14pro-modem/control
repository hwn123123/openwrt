	json_add_boolean radio_refresh_available "$(qmicli --help-nas 2>/dev/null | grep -q -- --nas-bind-subscription && echo 1 || echo 0)"
	json_dump
}

set_data() {
	local sim1_apn="$1" sim2_apn="$2" iptype="$3" roaming="$4" autoconnect="$5"
	case "$sim1_apn" in
		*[!A-Za-z0-9._-]*) fail "卡槽 1 APN 包含不支持的字符" ;;
	esac
	case "$sim2_apn" in
		*[!A-Za-z0-9._-]*) fail "卡槽 2 APN 包含不支持的字符" ;;
	esac
	case "$iptype" in ipv4|ipv6|ipv4v6) ;; *) fail "PDP 类型无效" ;; esac
	case "$roaming" in 0|1) ;; *) fail "漫游参数无效" ;; esac
	case "$autoconnect" in 0|1) ;; *) fail "自动连接参数无效" ;; esac

	uci set "xm14cellular.main.sim1_apn=$sim1_apn" || fail "保存卡槽 1 APN 失败"
	uci set "xm14cellular.main.sim2_apn=$sim2_apn" || fail "保存卡槽 2 APN 失败"
	uci -q delete xm14cellular.main.apn
	uci set "xm14cellular.main.iptype=$iptype" || fail "保存 PDP 类型失败"
	uci set "xm14cellular.main.roaming=$roaming" || fail "保存漫游设置失败"
	uci set "xm14cellular.main.autoconnect=$autoconnect" || fail "保存自动连接失败"
	uci commit xm14cellular || fail "提交拨号设置失败"

	# Keep netifd's real interface parameters in sync without restarting the
	# modem stack. resolve-apn selects the active SIM's APN before dialing.
	uci set "network.cellular.iptype=$iptype" || fail "更新网络 PDP 类型失败"
	uci set "network.cellular.allow_roaming=$roaming" || fail "更新网络漫游设置失败"
	# Automatic ifup belongs exclusively to xm14pro-modem/autoconnect, after
	# the embedded modem and selected UIM subscription are ready.
	uci set "network.cellular.auto=0" || fail "更新网络自动连接策略失败"
	uci commit network || fail "提交网络设置失败"
	logger -t "$TAG" "updated per-SIM cellular dial settings; empty APN uses that SIM's home carrier profile"
	status_json
}

set_slot() {
	local kind="$1" slot="$2" option target subscription dds_command expected_dds switched=0
	local current_subscription current_session_subscription current_dds output net tmp count up pending error
	case "$kind" in
		data) option=data_slot ;;
		voice) option=voice_slot ;;
		sms) option=sms_slot ;;
		*) fail "未知的卡槽用途：$kind" ;;
	esac
	case "$slot" in
		auto|1|2) ;;
		*) fail "卡槽只能是 auto、1 或 2" ;;
	esac

	if [ "$kind" = data ]; then
		[ -x "$DDS_CONTROL" ] || fail "数据卡切换程序未安装"
		case "$slot" in
			1|2)
				target="$slot"
				[ "$(file_value "$UIM_STATE" "slot${target}_ready")" = 1 ] ||
					fail "卡槽 ${target} 未就绪"
				;;
			auto)
				current_subscription="$(cat "$STATE_ROOT/qmi-subscription" 2>/dev/null)"
				case "$current_subscription" in
					0) [ "$(file_value "$UIM_STATE" slot1_ready)" = 1 ] && target=1 ;;
					1) [ "$(file_value "$UIM_STATE" slot2_ready)" = 1 ] && target=2 ;;
				esac
				if [ -z "$target" ]; then
					if [ "$(file_value "$UIM_STATE" slot1_ready)" = 1 ]; then target=1
					elif [ "$(file_value "$UIM_STATE" slot2_ready)" = 1 ]; then target=2
					else fail "没有已就绪的 SIM 卡"
					fi
				fi
				;;
		esac

		case "$target" in
			1) subscription=0; dds_command=primary; expected_dds=1 ;;
			2) subscription=1; dds_command=secondary; expected_dds=2 ;;
		esac
		# Persist the user's selection before touching the live session.  This is
		# also the cold-boot source of truth.  Keeping the old value until after a
		# long DDS transition allowed the startup worker to redial the old card.
		uci set "xm14cellular.main.$option=$slot" || fail "保存卡槽设置失败"
		uci commit xm14cellular || fail "提交卡槽设置失败"
		logger -t "$TAG" "configured $kind default slot: $slot"
		current_subscription="$(cat "$STATE_ROOT/qmi-subscription" 2>/dev/null)"
		current_session_subscription="$(file_value "$DSI_STATE" qmi_subscription)"
		net="$(network_status)"
		up="$(json_value "$net" '@.up')"
		pending="$(json_value "$net" '@.pending')"
		output="$(timeout -k 2 25 "$DDS_CONTROL" "$ANDROID_COMPAT_ROOT" get 2>&1)" ||
			fail "读取当前上网卡失败：$output"
		current_dds="$(printf '%s\n' "$output" | sed -n 's/^dds=//p' | tail -n 1)"

		if [ "$current_subscription" != "$subscription" ] ||
		   [ "$current_dds" != "$expected_dds" ] ||
		   { { [ "$up" = true ] || [ "$pending" = true ]; } &&
		     [ "$current_session_subscription" != "$subscription" ]; }; then
			switched=1
			mkdir -p "$STATE_ROOT" || fail "创建运行状态目录失败"
			: > "$DATA_SWITCH_FILE" || fail "创建数据卡切换状态失败"
			trap 'rm -f "$DATA_SWITCH_FILE"' EXIT INT TERM
			/sbin/ifdown cellular >/dev/null 2>&1 || fail "停止当前数据连接失败"
			count=0
			while [ -d "$STATE_ROOT/dsi-cellular.lock" ] && [ "$count" -lt 15 ]; do
				count=$((count + 1))
				sleep 1
			done
			[ ! -d "$STATE_ROOT/dsi-cellular.lock" ] || fail "当前数据连接未能及时停止"

			output="$(timeout -k 2 30 "$DDS_CONTROL" "$ANDROID_COMPAT_ROOT" "$dds_command" 2>&1)" ||
				fail "切换到卡槽 ${target} 失败：$output"
			[ "$(printf '%s\n' "$output" | sed -n 's/^after=//p' | tail -n 1)" = "$expected_dds" ] ||
				fail "基带未确认切换到卡槽 ${target}"

			tmp="$STATE_ROOT/qmi-subscription.$$"
			printf '%s\n' "$subscription" > "$tmp" && mv -f "$tmp" "$STATE_ROOT/qmi-subscription" || {
				rm -f "$tmp"
				fail "更新数据卡订阅失败"
			}
		fi
	else
		uci set "xm14cellular.main.$option=$slot" || fail "保存卡槽设置失败"
		uci commit xm14cellular || fail "提交卡槽设置失败"
		logger -t "$TAG" "configured $kind default slot: $slot"
	fi

	if [ "$kind" = data ] && [ "$switched" = 1 ] &&
	   [ "$(uci_value enabled)" != 0 ] && [ "$(uci_value autoconnect)" != 0 ]; then
		/usr/libexec/xm14pro-modem/resolve-apn >/dev/null 2>&1 ||
			fail "已切换到卡槽 ${target}，但未获取到可用 APN"
		rm -f "$DSI_ERROR"
		/sbin/ifup cellular >/dev/null 2>&1 ||
			fail "已切换到卡槽 ${target}，但启动数据连接失败"
		count=0
		while [ "$count" -lt 60 ]; do
			output="$(network_status)"
			up="$(json_value "$output" '@.up')"
			[ "$up" = true ] && break
			error="$(cat "$DSI_ERROR" 2>/dev/null)"
			[ -z "$error" ] || fail "已切换到卡槽 ${target}，但数据拨号失败：$error"
			count=$((count + 1))
			sleep 1
		done
		[ "$up" = true ] || fail "已切换到卡槽 ${target}，但数据连接超时"
		/usr/libexec/xm14pro-modem/radio-status >/dev/null 2>&1 &
		/usr/libexec/xm14pro-modem/telecom-status >/dev/null 2>&1 &
	fi
	status_json
}

set_airplane() {
	local enabled="$1" state
	case "$enabled" in
		1|true|on) state=low-power ;;
		0|false|off) state=on ;;
		*) fail "飞行模式参数无效" ;;
	esac
	if [ "$state" = low-power ]; then
		/sbin/ifdown cellular >/dev/null 2>&1 || true
		timeout -k 2 15 qmicli -d qrtr://0 --dms-set-operating-mode=low-power >/dev/null 2>&1 || {
			/sbin/ifup cellular >/dev/null 2>&1 || true
			fail "切换基带到低功耗模式失败"
		}
		printf '1\n' > "$AIRPLANE_STATE"
	else
		timeout -k 2 15 qmicli -d qrtr://0 --dms-set-operating-mode=online >/dev/null 2>&1 ||
			fail "恢复基带在线模式失败"
		printf '0\n' > "$AIRPLANE_STATE"
		/sbin/ifup cellular >/dev/null 2>&1 || fail "恢复蜂窝数据连接失败"
	fi
	logger -t "$TAG" "airplane mode request: $enabled"
	status_json
}

connection() {
	case "$1" in
		connect)
			/usr/libexec/xm14pro-modem/resolve-apn >/dev/null 2>&1 || fail "当前 SIM 没有可用的真实 APN/运营商配置"
			/sbin/ifup cellular >/dev/null 2>&1 || fail "启动蜂窝接口失败"
			;;
		disconnect) /sbin/ifdown cellular >/dev/null 2>&1 || fail "停止蜂窝接口失败" ;;
	esac
	status_json
}

logs_json() {
	local lines
	lines="$(logread 2>/dev/null | grep -E 'xm14|ModemManager|modemmanager|qmi|qrtr|rmnet|rmtfs|mpss' | tail -n 250)"
	json_init
	json_add_boolean ok 1
	json_add_string logs "$lines"
	json_dump
}

refresh_radio() {
	[ -x /usr/libexec/xm14pro-modem/radio-status ] || fail "实时无线状态工具未安装"
	/usr/libexec/xm14pro-modem/radio-status >/dev/null 2>&1 || fail "读取当前 SIM 的无线状态失败"
	status_json
}

refresh_telecom() {
	[ -x /usr/libexec/xm14pro-modem/telecom-status ] || fail "电话与短信状态工具未安装"
	/usr/libexec/xm14pro-modem/telecom-status >/dev/null 2>&1 || fail "读取当前 SIM 的电话与短信状态失败"
	status_json
}

phone_number_valid() {
	printf '%s\n' "$1" | grep -Eq '^\+?[0-9*#]{2,32}$'
}

telephony_action() {
	local action="$1" value="$2" tone="$3" output slot call_id
	[ -x "$TELEPHONY_LAUNCHER" ] || fail "Android 无线电启动器未安装"
	[ -x "$RADIO_SMS_CLIENT" ] || fail "Qualcomm IMS 控制程序未安装"
	case "$action" in
		call-dial) slot="$(selected_phone_slot voice)" ;;
		call-answer|call-end|call-dtmf)
			slot="$(call_value active_call_slot)"
			case "$slot" in slot1|slot2) ;; *) slot="$(selected_phone_slot voice)" ;; esac
			;;
	esac
	[ -n "$slot" ] || fail "语音默认卡未插卡或未就绪"
	ims_aidl_ready "$slot" || fail "语音 IMS 尚未在选定卡上注册完成"
	case "$action" in
		call-dial)
			phone_number_valid "$value" || fail "电话号码格式无效"
			output="$(timeout -k 2 45 "$TELEPHONY_LAUNCHER" "$ANDROID_COMPAT_ROOT" radio-sms call-dial "$slot" "$value" 2>&1)" || fail "$output"
			call_id="$(printf '%s\n' "$output" | jsonfilter -e '@.call_id' 2>/dev/null)"
			if ! [ -x "$AUDIO_CONTROL" ] ||
			   ! $AUDIO_CONTROL call-start earpiece "${slot#slot}" >/dev/null 2>&1; then
				case "$call_id" in ''|*[!0-9]*) ;; *)
					timeout -k 2 15 "$TELEPHONY_LAUNCHER" "$ANDROID_COMPAT_ROOT" radio-sms call-end "$slot" "$call_id" >/dev/null 2>&1
				;; esac
				fail "通话声路启动失败，已安全取消拨号"
			fi
			;;
		call-answer|call-end)
			case "$value" in ''|*[!0-9]*) fail "通话 ID 无效" ;; esac
			if [ "$action" = call-answer ]; then
				output="$(timeout -k 2 45 "$TELEPHONY_LAUNCHER" "$ANDROID_COMPAT_ROOT" radio-sms call-answer "$slot" 2>&1)" || fail "$output"
				if ! [ -x "$AUDIO_CONTROL" ] ||
				   ! $AUDIO_CONTROL call-start earpiece "${slot#slot}" >/dev/null 2>&1; then
					timeout -k 2 15 "$TELEPHONY_LAUNCHER" "$ANDROID_COMPAT_ROOT" radio-sms call-end "$slot" "$value" >/dev/null 2>&1
					fail "通话声路启动失败，已挂断本次通话"
				fi
			else
				mark_call_action "$value"
				if ! output="$(timeout -k 2 45 "$TELEPHONY_LAUNCHER" "$ANDROID_COMPAT_ROOT" radio-sms call-end "$slot" "$value" 2>&1)"; then
					rm -f "$CALL_ACTION"
					fail "$output"
				fi
				[ ! -x "$AUDIO_CONTROL" ] || $AUDIO_CONTROL call-stop >/dev/null 2>&1
			fi
			;;
		call-dtmf)
			case "$value" in ''|*[!0-9]*) fail "通话 ID 无效" ;; esac
			case "$tone" in [0-9]|\*|\#|A|B|C|D) ;; *) fail "DTMF 按键无效" ;; esac
			output="$(timeout -k 2 35 "$TELEPHONY_LAUNCHER" "$ANDROID_COMPAT_ROOT" radio-sms call-dtmf "$slot" "$value" "$tone" 2>&1)" || fail "$output"
			;;
		*) fail "不支持的电话操作" ;;
	esac
	printf '%s\n' "$output"
}

call_audio_action() {
	local action="$1" value="$2" output
	[ -x "$AUDIO_CONTROL" ] || fail "通话音频控制程序未安装"
	case "$action:$value" in
		call-audio-route:earpiece) output="$($AUDIO_CONTROL call-route earpiece 2>&1)" || fail "$output" ;;
		call-audio-route:speaker) output="$($AUDIO_CONTROL call-route speaker 2>&1)" || fail "$output" ;;
		call-audio-mute:0) output="$($AUDIO_CONTROL call-mute 0 2>&1)" || fail "$output" ;;
		call-audio-mute:1) output="$($AUDIO_CONTROL call-mute 1 2>&1)" || fail "$output" ;;
		call-audio-volume:*)
			case "$value" in ''|*[!0-9]*) fail "通话音量无效" ;; esac
			[ "$value" -le 100 ] 2>/dev/null || fail "通话音量必须为 0-100"
			output="$($AUDIO_CONTROL volume call "$value" 2>&1)" || fail "$output"
			;;
		*) fail "不支持的通话音频操作" ;;
	esac
	printf '%s\n' "$output"
}

sms_send() {
	local number="$1" message="$2" output message_id message_ids segments timestamp timestamp_epoch record slot transport ref
	umask 077
	[ -x "$TELEPHONY_LAUNCHER" ] || fail "Android 无线电启动器未安装"
	[ -x "$RADIO_SMS_CLIENT" ] || fail "Android Radio Messaging 客户端未安装"
	phone_number_valid "$number" || fail "收件人号码格式无效"
	[ -n "$message" ] || fail "短信内容不能为空"
	slot="$(selected_phone_slot sms)" || fail "短信默认卡未插卡或未就绪"
	ims_aidl_ready "$slot" || fail "IMS 应用层尚未在选定卡上完成本次冷启动注册，已禁止发送"
	transport=ims
	output="$(timeout -k 2 330 "$TELEPHONY_LAUNCHER" "$ANDROID_COMPAT_ROOT" radio-sms send "$slot" "$transport" "$number" "$message" 2>&1)" || fail "$output"
	message_id="$(printf '%s\n' "$output" | jsonfilter -e '@.message_id' 2>/dev/null)"
	message_ids="$(printf '%s\n' "$output" | jsonfilter -e '@.message_ids[@]' 2>/dev/null)"
	segments="$(printf '%s\n' "$output" | jsonfilter -e '@.segments' 2>/dev/null)"
	transport="$(printf '%s\n' "$output" | jsonfilter -e '@.transport' 2>/dev/null)"
	[ "$(printf '%s\n' "$output" | jsonfilter -e '@.ok' 2>/dev/null)" = true ] || fail "Radio Messaging 未返回真实发送成功结果"
	timestamp="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
	timestamp_epoch="$(date +%s 2>/dev/null)"
	mkdir -p /var/lib/xm14pro/sms
	record="/var/lib/xm14pro/sms/$(date +%s 2>/dev/null)-$$.sent.json"
	json_init
	json_add_boolean ok 1
	json_add_string direction out
	json_add_string number "$number"
	json_add_string timestamp "$timestamp"
	json_add_int timestamp_epoch "$timestamp_epoch"
	json_add_string text "$message"
	json_add_string message_id "$message_id"
	json_add_array message_ids
	for ref in $message_ids; do
		case "$ref" in ''|*[!0-9]*) continue ;; esac
		json_add_int "" "$ref"
	done
	json_close_array
	json_add_string delivery pending
	json_add_string transport "$transport"
	json_add_string slot "$slot"
	json_int_or_null segments "$segments"
	json_dump > "$record"
	printf '%s\n' "$output"
}

message_decode_file() {
	case "$1" in
		*.pdu) /usr/sbin/xm14pro-telephony pdu-decode "$(cat "$1" 2>/dev/null)" 2>/dev/null ;;
		*.sent.json) cat "$1" 2>/dev/null ;;
		*) return 1 ;;
	esac
}

message_record_id() {
	local file="$1" prefix=local
	case "$file" in "$DELIVERY_ROOT"/*) prefix=ims ;; esac
	printf '%s:%s\n' "$prefix" "${file##*/}"
}

message_record_path() {
	local id="$1" prefix name path
	prefix="${id%%:*}"
	name="${id#*:}"
	[ "$prefix" != "$id" ] || return 1
	[ -n "$name" ] || return 1
	[ "${name##*/}" = "$name" ] || return 1
	case "$name" in *..*) return 1 ;; esac
	printf '%s\n' "$name" | LC_ALL=C grep -Eq '^[A-Za-z0-9._-]+$' || return 1
	case "$prefix" in
		local) path="/var/lib/xm14pro/sms/$name" ;;
		ims) path="$DELIVERY_ROOT/$name" ;;
		*) return 1 ;;
	esac
	case "$path" in *.pdu|*.sent.json) ;; *) return 1 ;; esac
	[ -f "$path" ] || return 1
	printf '%s\n' "$path"
}

message_state_path() {
	local id="$1" name
	case "$id" in local:*|ims:*) ;; *) return 1 ;; esac
	name="$(printf '%s' "$id" | tr ':' '_')"
	printf '%s\n' "$name" | LC_ALL=C grep -Eq '^[A-Za-z0-9._-]+$' || return 1
	printf '%s/%s.read\n' "$MESSAGE_STATE" "$name"
}

message_unread_path() {
	local marker
	marker="$(message_state_path "$1")" || return 1
	printf '%s\n' "${marker%.read}.unread"
}

sim_record_action() {
	local path="$1" action="$2" source index slot subscription current cached key response
	source="$(jsonfilter -i "$path" -e '@.source' 2>/dev/null)"
	[ "$source" = sim ] || return 0
	index="$(jsonfilter -i "$path" -e '@.sim_index' 2>/dev/null)"
	slot="$(jsonfilter -i "$path" -e '@.slot' 2>/dev/null)"
	case "$index" in ''|*[!0-9]*) return 1 ;; esac
	[ "$slot" = "$(selected_phone_slot sms 2>/dev/null)" ] || return 1
	subscription="$(cat "$STATE_ROOT/qmi-subscription" 2>/dev/null)"
	case "$subscription:$slot" in 0:slot1|1:slot2) ;; *) return 1 ;; esac
	# Avoid changing a newly reused SIM index using a stale cached message.
	current="$(timeout -k 2 12 /usr/sbin/xm14pro-telephony sms-read uim "$index" 2>/dev/null)" || return 1
	for key in number timestamp text; do
		cached="$(jsonfilter -i "$path" -e "@.$key" 2>/dev/null)"
		[ "$cached" = "$(printf '%s\n' "$current" | jsonfilter -e "@.$key" 2>/dev/null)" ] || return 1
	done
	case "$action" in read|unread) response="$(timeout -k 2 12 /usr/sbin/xm14pro-telephony sms-tag uim "$index" "$action" 2>/dev/null)" || return 1 ;;
		delete) response="$(timeout -k 2 12 /usr/sbin/xm14pro-telephony sms-delete uim "$index" 2>/dev/null)" || return 1 ;;
		*) return 1 ;;
	esac
	[ "$(printf '%s\n' "$response" | jsonfilter -e '@.ok' 2>/dev/null)" = true ]
}

sim_cache_time() {
	local cache="$1" stamp when
	stamp="$(jsonfilter -i "$cache" -e '@.timestamp' 2>/dev/null)"
	case "$stamp" in [0-9][0-9]-*) stamp="20$stamp" ;; esac
	when="$(date -d "$stamp" +%Y%m%d%H%M.%S 2>/dev/null)"
	[ -z "$when" ] || touch -t "$when" "$cache"
}

message_set_read() {
	local id="$1" state="$2" marker unread temporary
	marker="$(message_state_path "$id")" || return 1
	unread="$(message_unread_path "$id")" || return 1
	case "$id" in local:sim-*) sim_record_action "$(message_record_path "$id")" "$([ "$state" = 1 ] && printf read || printf unread)" || return 1 ;; esac
	mkdir -p "$MESSAGE_STATE" || return 1
	case "$state" in
		1)
			temporary="$marker.$$"
			printf '%s\n' "$(date +%s)" > "$temporary" && mv "$temporary" "$marker" || return 1
			rm -f -- "$unread"
			;;
		0)
			temporary="$unread.$$"
			printf '%s\n' "$(date +%s)" > "$temporary" && mv "$temporary" "$unread" || return 1
			rm -f -- "$marker"
			;;
		*) return 1 ;;
	esac
}

sim_sync() {
	local slot subscription tag list entries index actual_tag cache tombstone deleted_at now decoded temporary imported=0 listed=0
	umask 077
	slot="$(selected_phone_slot sms)" || fail "当前没有可用的短信 SIM 卡"
	subscription="$(cat "$STATE_ROOT/qmi-subscription" 2>/dev/null)"
	case "$subscription:$slot" in 0:slot1|1:slot2) ;; *) fail "短信 SIM 与 QMI 当前卡不一致" ;; esac
	command -v qmicli >/dev/null 2>&1 || fail "缺少 QMI 短信工具"
	[ -x /usr/sbin/xm14pro-telephony ] || fail "缺少 SIM 短信读取器"
	mkdir -p "$SIM_CACHE" "$MESSAGE_STATE" || fail "短信缓存目录不可写"
	chmod 0700 "$SIM_CACHE" "$MESSAGE_STATE" || fail "短信缓存目录权限设置失败"
	# This is an explicit refresh, never part of the three-second mailbox poll.
	for tag in mt-read mt-not-read mo-sent mo-not-sent; do
		list="$(timeout -k 2 12 qmicli -d qrtr://0 "--wms-list-messages=uim,$tag" 2>/dev/null)" || continue
		entries="$(printf '%s\n' "$list" | awk -F"'" '/Index:/ { idx=$2 } /Tag:/ { if (idx ~ /^[0-9]+$/ && $2 ~ /^(mt-read|mt-not-read|mo-sent|mo-not-sent)$/) print idx, $2; idx="" }' | head -n 200)"
		while read -r index actual_tag; do
			[ -n "$index" ] || continue
			listed=$((listed + 1))
			cache="$SIM_CACHE/sim-${slot}-${index}.sent.json"
			tombstone="$MESSAGE_STATE/sim-${slot}-${index}.sent.json.deleted"
			if [ -e "$tombstone" ]; then
				deleted_at="$(cat "$tombstone" 2>/dev/null)"
				now="$(date +%s)"
				case "$deleted_at" in ''|*[!0-9]*) deleted_at=0 ;; esac
				[ "$deleted_at" -le "$now" ] && [ "$now" -lt "$((deleted_at + 300))" ] && continue
				rm -f -- "$tombstone"
			fi
			if [ -s "$cache" ]; then
				[ "$(jsonfilter -i "$cache" -e '@.sim_tag' 2>/dev/null)" = "$actual_tag" ] || {
					temporary="$cache.$$"
					sed "s/\"sim_tag\":\"[^\"]*\"/\"sim_tag\":\"$actual_tag\"/" "$cache" > "$temporary" && mv "$temporary" "$cache" &&
						rm -f -- "$MESSAGE_STATE/local_sim-${slot}-${index}.sent.json.read" "$MESSAGE_STATE/local_sim-${slot}-${index}.sent.json.unread"
				}
				sim_cache_time "$cache"
				continue
			fi
			decoded="$(timeout -k 2 12 /usr/sbin/xm14pro-telephony sms-read uim "$index" 2>/dev/null)" || continue
			[ "$(printf '%s\n' "$decoded" | jsonfilter -e '@.ok' 2>/dev/null)" = true ] || continue
			temporary="$cache.$$"
			printf '%s\n' "$decoded" | sed "s/^{/{\"source\":\"sim\",\"sim_tag\":\"$actual_tag\",\"slot\":\"$slot\",\"sim_index\":$index,/" > "$temporary" || continue
			mv "$temporary" "$cache" || continue
			sim_cache_time "$cache"
			imported=$((imported + 1))
		done <<EOF
$entries
EOF
	done
	printf '{"ok":true,"listed":%d,"imported":%d}\n' "$listed" "$imported"
}

normalized_message_number() {
	printf '%s' "$1" | tr -cd '0-9+*#'
}

sms_delete_json() {
	local mode="$1" value="$2" id path marker file decoded number target deleted=0 old_ifs
	case "$mode" in
		record)
			old_ifs="$IFS"
			IFS=,
			for id in $value; do
				path="$(message_record_path "$id")" || { IFS="$old_ifs"; fail "短信记录不存在或标识无效"; }
				sim_record_action "$path" delete || { IFS="$old_ifs"; fail "删除 SIM 短信失败，记录仍保留"; }
				rm -f -- "$path" || { IFS="$old_ifs"; fail "删除短信记录失败"; }
				marker="$(message_state_path "$id" 2>/dev/null)" && rm -f -- "$marker" "${marker%.read}.unread"
				case "$id" in local:sim-*) printf '%s\n' "$(date +%s)" > "$MESSAGE_STATE/${id#local:}.deleted" ;; esac
				deleted=$((deleted + 1))
			done
			IFS="$old_ifs"
			[ "$deleted" -gt 0 ] || fail "没有选择要删除的短信"
			;;
		thread)
			target="$(normalized_message_number "$value")"
			[ -n "$target" ] || fail "短信号码无效"
			for file in /var/lib/xm14pro/sms/*.pdu /var/lib/xm14pro/sms/*.sent.json "$DELIVERY_ROOT"/incoming-*.pdu; do
				[ -f "$file" ] || continue
				decoded="$(message_decode_file "$file")" || continue
				number="$(printf '%s\n' "$decoded" | jsonfilter -e '@.number' 2>/dev/null)"
				[ "$(normalized_message_number "$number")" = "$target" ] || continue
				id="$(message_record_id "$file")"
				sim_record_action "$file" delete || fail "删除 SIM 短信失败，记录仍保留"
				rm -f -- "$file" || fail "删除同号码短信记录失败"
				marker="$(message_state_path "$id" 2>/dev/null)" && rm -f -- "$marker" "${marker%.read}.unread"
				case "$id" in local:sim-*) printf '%s\n' "$(date +%s)" > "$MESSAGE_STATE/${id#local:}.deleted" ;; esac
				deleted=$((deleted + 1))
			done
			;;
		all)
			for file in /var/lib/xm14pro/sms/*.pdu /var/lib/xm14pro/sms/*.sent.json "$DELIVERY_ROOT"/incoming-*.pdu "$DELIVERY_ROOT"/delivery-*.json; do
				[ -f "$file" ] || continue
				sim_record_action "$file" delete || fail "删除 SIM 短信失败，记录仍保留"
				case "${file##*/}" in sim-*.sent.json)
					mkdir -p "$MESSAGE_STATE"
					printf '%s\n' "$(date +%s)" > "$MESSAGE_STATE/${file##*/}.deleted"
					;; esac
				rm -f -- "$file" || fail "清空短信记录失败"
				deleted=$((deleted + 1))
			done
			for marker in "$MESSAGE_STATE"/*.read "$MESSAGE_STATE"/*.unread; do
				[ -f "$marker" ] || continue
				rm -f -- "$marker" || fail "清空短信已读状态失败"
			done
			;;
		*) fail "不支持的短信删除操作" ;;
	esac
	printf '{"ok":true,"deleted":%d}\n' "$deleted"
}

sms_read_json() {
	local mode="$1" value="$2" state="$3" id path file decoded number direction target changed=0 old_ifs
	case "$state" in 0|1) ;; *) fail "短信已读状态无效" ;; esac
	case "$mode" in
		record)
			old_ifs="$IFS"
			IFS=,
			for id in $value; do
				path="$(message_record_path "$id")" || { IFS="$old_ifs"; fail "短信记录不存在或标识无效"; }
				message_set_read "$id" "$state" || { IFS="$old_ifs"; fail "保存短信已读状态失败"; }
				changed=$((changed + 1))
			done
			IFS="$old_ifs"
			;;
		thread)
			target="$(normalized_message_number "$value")"
			[ -n "$target" ] || fail "短信号码无效"
			for file in /var/lib/xm14pro/sms/*.pdu /var/lib/xm14pro/sms/*.sent.json "$DELIVERY_ROOT"/incoming-*.pdu; do
				[ -f "$file" ] || continue
				decoded="$(message_decode_file "$file")" || continue
				number="$(printf '%s\n' "$decoded" | jsonfilter -e '@.number' 2>/dev/null)"
				[ "$(normalized_message_number "$number")" = "$target" ] || continue
				direction="$(printf '%s\n' "$decoded" | jsonfilter -e '@.direction' 2>/dev/null)"
				[ "$direction" = in ] || continue
				id="$(message_record_id "$file")"
				message_set_read "$id" "$state" || fail "保存同号码短信已读状态失败"
				changed=$((changed + 1))
			done
			;;
		*) fail "不支持的短信已读操作" ;;
	esac
	printf '{"ok":true,"changed":%d,"read":%s}\n' "$changed" "$([ "$state" = 1 ] && printf true || printf false)"
}

messages_json() {
	local file decoded record_id marker direction read_state comma= active=0 slot
	slot="$(selected_phone_slot sms 2>/dev/null)"
	[ -n "$slot" ] && command_running 'xm14pro-radio-sms ims-daemon' && ims_aidl_ready "$slot" && active=1
	printf '{"ok":true,"receive_active":%s,"messages":[' "$([ "$active" = 1 ] && printf true || printf false)"
	for file in $(ls -1t /var/lib/xm14pro/sms/*.pdu /var/lib/xm14pro/sms/*.sent.json "$DELIVERY_ROOT"/incoming-*.pdu 2>/dev/null | head -n 200); do
		decoded="$(message_decode_file "$file")" || continue
		[ -n "$decoded" ] || continue
		[ "$(printf '%s\n' "$decoded" | jsonfilter -e '@.ok' 2>/dev/null)" = true ] || continue
		record_id="$(message_record_id "$file")"
		direction="$(printf '%s\n' "$decoded" | jsonfilter -e '@.direction' 2>/dev/null)"
		marker="$(message_state_path "$record_id" 2>/dev/null)"
		if [ "$direction" != in ] || [ -f "$marker" ] ||
		   { [ ! -f "${marker%.read}.unread" ] && [ "$(printf '%s\n' "$decoded" | jsonfilter -e '@.sim_tag' 2>/dev/null)" = mt-read ]; }; then
			read_state=true
		else
			read_state=false
		fi
		decoded="$(printf '%s\n' "$decoded" | sed "s/^{/{\"record_id\":\"$record_id\",\"read\":$read_state,/")"
		printf '%s%s' "$comma" "$decoded"
		comma=,
	done
	printf '],"receipts":['
	comma=
	for file in $(ls -1t "$DELIVERY_ROOT"/delivery-*.json 2>/dev/null | head -n 200); do
		decoded="$(cat "$file" 2>/dev/null)"
		[ -n "$decoded" ] || continue
		printf '%s%s' "$comma" "$decoded"
		comma=,
	done
	printf ']}\n'
}

call_history_json() {
	local file record comma=
	printf '{"ok":true,"calls":['
	for file in $(ls -1t "$CALL_HISTORY"/*.json 2>/dev/null | head -n 500); do
		record="$(cat "$file" 2>/dev/null)"
		[ -n "$record" ] || continue
		[ -n "$(printf '%s\n' "$record" | jsonfilter -e '@.id' 2>/dev/null)" ] || continue
		printf '%s%s' "$comma" "$record"
		comma=,
	done
	printf ']}\n'
}

screen_telephony() {
	local enabled="$1" output
	case "$enabled" in 0|1) ;; *) fail "屏幕短信电话开关参数无效" ;; esac
	uci -q set "xm14display.main.telephony_pages=$enabled" || fail "写入屏幕设置失败"
	uci -q commit xm14display || fail "保存屏幕设置失败"
	if [ -x /usr/libexec/xm14pro-display ]; then
		output="$(/usr/libexec/xm14pro-display apply 2>&1)" || fail "$output"
	fi
	printf '{"ok":true,"screen_telephony_pages":%s}\n' "$([ "$enabled" = 1 ] && printf true || printf false)"
}

case "${1:-status}" in
	status) status_json ;;
	set-data) set_data "$2" "$3" "$4" "$5" "$6" ;;
	set-slot) set_slot "$2" "$3" ;;
	set-airplane) set_airplane "$2" ;;
	connect|disconnect) connection "$1" ;;
	refresh-radio) refresh_radio ;;
	refresh-telecom) refresh_telecom ;;
	call-dial|call-answer|call-end|call-dtmf) telephony_action "$1" "$2" "$3" ;;
	call-audio-route|call-audio-mute|call-audio-volume) call_audio_action "$1" "$2" ;;
	screen-telephony) screen_telephony "$2" ;;
	sms-send) sms_send "$2" "$3" ;;
	messages) messages_json ;;
	sms-sync) sim_sync ;;
	sms-delete) sms_delete_json record "$2" ;;
	sms-delete-thread) sms_delete_json thread "$2" ;;
	sms-delete-all) sms_delete_json all ;;
	sms-read) sms_read_json record "$2" "$3" ;;
	sms-read-thread) sms_read_json thread "$2" "$3" ;;
	call-history) call_history_json ;;
	logs) logs_json ;;
	*) fail "不支持的操作：$1" ;;
esac
