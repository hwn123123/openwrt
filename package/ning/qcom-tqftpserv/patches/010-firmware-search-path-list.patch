+
+static int open_from_fw_path_list(const char *path_list,
+				  const char *firmware_path, const char *file)
+{
+	char *copy;
+	char *entry;
+	char *saveptr = NULL;
+	char path[PATH_MAX];
+	int fd = -1;
+
+	copy = strdup(path_list);
+	if (!copy)
+		return -1;
+	for (entry = strtok_r(copy, ",", &saveptr); entry;
+	     entry = strtok_r(NULL, ",", &saveptr)) {
+		if (snprintf(path, sizeof(path), "%s/%s/%s", entry,
+			     firmware_path, file) >= (int)sizeof(path))
+			continue;
+		fd = open_maybe_compressed(path);
+		if (fd >= 0)
+			break;
+		if (errno != ENOENT)
+			warn("failed to open %s", path);
+	}
+	free(copy);
+	return fd;
 }
 
