#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
START=07
STOP=89

start_service() {
	local enabled mac
	config_load xm14dms
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get mac main mac '02:14:14:14:00:01'

	procd_open_instance
	procd_set_param command /usr/sbin/xm14pro-dms-stub -m "$mac"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xm14dms
}
