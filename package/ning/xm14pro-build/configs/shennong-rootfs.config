CONFIG_TARGET_xm14pro=y
CONFIG_TARGET_xm14pro_armv8=y
CONFIG_TARGET_xm14pro_armv8_DEVICE_xiaomi_14_pro=y
CONFIG_TARGET_SERIAL="ttyMSM0"

CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_EROFS=y
CONFIG_TARGET_EROFS_PCLUSTER_SIZE=256
# The Xiaomi init_boot ramdisk is built by build-b-slot.sh. Never export an
# armsr initramfs tied to OpenWrt's unrelated kernel.
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=512

CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="nwrt"
CONFIG_VERSION_MANUFACTURER="ningge"
CONFIG_VERSION_PRODUCT="nwrt system for Xiaomi 14 Pro CPE"
CONFIG_VERSION_HOME_URL="https://github.com/hwn123123/openwrt"

CONFIG_PACKAGE_xm14pro-boot-shim=y
CONFIG_PACKAGE_xm14pro-defaults=y
CONFIG_PACKAGE_xm14pro-usb-gadget=y
CONFIG_PACKAGE_xm14pro-usb-sidecar=y
CONFIG_PACKAGE_xm14pro-audio-sidecar=y
CONFIG_PACKAGE_xm14pro-platform=y
CONFIG_PACKAGE_xm14pro-cellular=y
CONFIG_PACKAGE_xm14pro-bonding=y
CONFIG_PACKAGE_xm14pro-nicm=y
CONFIG_PACKAGE_xm14pro-qwes=y
CONFIG_PACKAGE_xm14pro-cpe-firewall=y
CONFIG_PACKAGE_xm14pro-openclash-compat=y
CONFIG_PACKAGE_xm14pro-openclash-core=y
CONFIG_PACKAGE_xm14pro-iptables=y
CONFIG_PACKAGE_qcom-qrtr=y
CONFIG_PACKAGE_qcom-rmtfs=y
CONFIG_PACKAGE_qcom-pd-mapper=y
CONFIG_PACKAGE_qcom-tqftpserv=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_kmod=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Selected LuCI applications included in the Xiaomi 14 Pro base image.
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_xm14pro-cellular-webui=y
CONFIG_PACKAGE_luci-i18n-xm14pro-mobile-zh-cn=y
CONFIG_PACKAGE_xm14pro-battery=y
CONFIG_PACKAGE_luci-i18n-xm14pro-battery-zh-cn=y
CONFIG_PACKAGE_xm14pro-display=y
CONFIG_PACKAGE_xm14pro-display-webui=y
CONFIG_PACKAGE_libqrencode=y
CONFIG_PACKAGE_luci-i18n-xm14pro-display-zh-cn=y
CONFIG_PACKAGE_xm14pro-android-switch=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-app-openclash=y

# Full Docker userspace.  install-docker-compat.sh keeps OpenWrt 6.18 kernel
# modules out of this Xiaomi stock-6.1 rootfs while preserving Docker Engine,
# Compose and the LuCI management interface.
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_DOCKER_STO_EXT4=y

# Stock Xiaomi 6.1 drivers are loaded by the boot shim; these are userspace
# components only and therefore do not introduce an OpenWrt-kernel ABI mix.
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_modemmanager-rpcd=y
CONFIG_MODEMMANAGER_WITH_NETIFD=y
CONFIG_MODEMMANAGER_WITH_QMI=y
CONFIG_MODEMMANAGER_WITH_QRTR=y
CONFIG_MODEMMANAGER_WITH_BUILTIN_PLUGINS=y
CONFIG_LIBQMI_WITH_QRTR_GLIB=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
CONFIG_PACKAGE_xm14pro-stock-modules=y
CONFIG_PACKAGE_xm14pro-dms-stub=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y

# The phone boots Xiaomi's stock 6.1 kernel. Sound, DRM and input support are
# already enabled in that kernel; these are ABI-safe userspace tools used by
# the native call-audio and local-screen integrations.
CONFIG_PACKAGE_alsa-utils=y
CONFIG_PACKAGE_evtest=y
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_video-support=y
CONFIG_PACKAGE_libdrm=y
CONFIG_PACKAGE_libdrm-tests=y

# The stock Xiaomi kernel has no nftables ABI matching OpenWrt 6.18 packages.
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_nftables-json is not set
# CONFIG_PACKAGE_luci-app-firewall is not set

# No OpenWrt-built kernel module may be installed into the exported rootfs.
# Device-default kmods are removed from the Xiaomi profile by prepare.sh after
# defconfig. Per-device rootfs mode is required so negative profile packages
# are preserved by Kconfig.

