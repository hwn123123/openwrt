+static void
+list_messages_ready (QmiClientWms *client,
+                     GAsyncResult *res)
+{
+    QmiMessageWmsListMessagesOutput *output;
+    GError *error = NULL;
+    GArray *messages = NULL;
+    guint i;
+
+    output = qmi_client_wms_list_messages_finish (client, res, &error);
+    if (!output) {
+        g_printerr ("error: operation failed: %s\n", error->message);
+        g_error_free (error);
+        operation_shutdown (FALSE);
+        return;
+    }
+
+    if (!qmi_message_wms_list_messages_output_get_result (output, &error)) {
+        g_printerr ("error: couldn't list SMS messages: %s\n", error->message);
+        g_error_free (error);
+        qmi_message_wms_list_messages_output_unref (output);
+        operation_shutdown (FALSE);
+        return;
+    }
+
+    qmi_message_wms_list_messages_output_get_message_list (output, &messages, NULL);
+    g_print ("[%s] Successfully listed SMS messages:\n"
+             "Message count: %u\n",
+             qmi_device_get_path_display (ctx->device),
+             messages ? messages->len : 0);
+
+    for (i = 0; messages && i < messages->len; i++) {
+        QmiMessageWmsListMessagesOutputMessageListElement *message;
+
+        message = &g_array_index (messages, QmiMessageWmsListMessagesOutputMessageListElement, i);
+        g_print ("Message:\n"
+                 "\tIndex: '%u'\n"
+                 "\tTag: '%s'\n",
+                 message->memory_index,
+                 VALIDATE_UNKNOWN (qmi_wms_message_tag_type_get_string (message->message_tag)));
+    }
+
+    qmi_message_wms_list_messages_output_unref (output);
+    operation_shutdown (TRUE);
+}
+
+static QmiMessageWmsListMessagesInput *
+list_messages_input_create (const gchar  *str,
+                            GError      **error)
+{
+    QmiMessageWmsListMessagesInput *input;
+    QmiWmsStorageType storage;
+    QmiWmsMessageTagType tag;
+    gchar **parts;
+
+    parts = g_strsplit (str, ",", -1);
+    if (!parts[0] || !parts[1] || parts[2] || !parts[0][0] || !parts[1][0]) {
+        g_set_error (error,
+                     QMI_CORE_ERROR,
+                     QMI_CORE_ERROR_FAILED,
+                     "expected storage,tag (for example: uim,mt-read)");
+        g_strfreev (parts);
+        return NULL;
+    }
+
+    if (!qmicli_read_wms_storage_type_from_string (parts[0], &storage)) {
+        g_set_error (error,
+                     QMI_CORE_ERROR,
+                     QMI_CORE_ERROR_FAILED,
+                     "unknown SMS storage '%s'",
+                     parts[0]);
+        g_strfreev (parts);
+        return NULL;
+    }
+
+    if (g_ascii_strcasecmp (parts[1], "mt-read") == 0)
+        tag = QMI_WMS_MESSAGE_TAG_TYPE_MT_READ;
+    else if (g_ascii_strcasecmp (parts[1], "mt-not-read") == 0)
+        tag = QMI_WMS_MESSAGE_TAG_TYPE_MT_NOT_READ;
+    else if (g_ascii_strcasecmp (parts[1], "mo-sent") == 0)
+        tag = QMI_WMS_MESSAGE_TAG_TYPE_MO_SENT;
+    else if (g_ascii_strcasecmp (parts[1], "mo-not-sent") == 0)
+        tag = QMI_WMS_MESSAGE_TAG_TYPE_MO_NOT_SENT;
+    else {
+        g_set_error (error,
+                     QMI_CORE_ERROR,
+                     QMI_CORE_ERROR_FAILED,
+                     "unknown SMS tag '%s'",
+                     parts[1]);
+        g_strfreev (parts);
+        return NULL;
+    }
+    g_strfreev (parts);
+
+    input = qmi_message_wms_list_messages_input_new ();
+    if (!qmi_message_wms_list_messages_input_set_storage_type (input, storage, error) ||
+        !qmi_message_wms_list_messages_input_set_message_tag (input, tag, error) ||
+        !qmi_message_wms_list_messages_input_set_message_mode (input, QMI_WMS_MESSAGE_MODE_GSM_WCDMA, error)) {
+        qmi_message_wms_list_messages_input_unref (input);
+        return NULL;
+    }
+
+    return input;
+}
