#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
START=68
STOP=36

ANDROID_ROOT=/usr/libexec/xm14pro-qwes/android-root
LAUNCHER=/usr/libexec/xm14pro-peripherals/launcher
PERMISSIONS=/usr/libexec/xm14pro-peripherals/apply-stock-permissions

manager_running() {
	local command="$1"
	ps w | awk -v command="$command" '
		index($0, command) && $0 !~ /awk -v command=/ { found = 1 }
		END { exit found ? 0 : 1 }
	'
}

wait_for_binder_managers() {
	local attempt=0
	while [ "$attempt" -lt 20 ]; do
		if manager_running '/system/bin/servicemanager' &&
		   manager_running '/system_ext/bin/hwservicemanager' &&
		   manager_running '/vendor/bin/vndservicemanager /dev/vndbinder'; then
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

add_instance() {
	local name="$1"
	local mode="$2"
	local argument="$3"
	procd_open_instance "$name"
	if [ -n "$argument" ]; then
		procd_set_param command "$LAUNCHER" "$ANDROID_ROOT" "$mode" "$argument"
	else
		procd_set_param command "$LAUNCHER" "$ANDROID_ROOT" "$mode"
	fi
	procd_set_param respawn 3600 5 3
	procd_set_param term_timeout 12
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

prepare_hotspot_config() {
	local directory="$ANDROID_ROOT/data/vendor/nfc/xm14"
	local section ssid key encryption temporary
	for section in nwrt_5g nwrt_24g; do
		ssid="$(uci -q get "wireless.$section.ssid")"
		key="$(uci -q get "wireless.$section.key")"
		encryption="$(uci -q get "wireless.$section.encryption")"
		[ -n "$ssid" ] && [ -n "$key" ] && break
	done
	[ -n "$ssid" ] && [ -n "$key" ] || {
		logger -t xm14pro-peripherals 'hotspot SSID or key is unavailable'
		return 1
	}
	temporary="$directory/hotspot.conf.$$"
	umask 077
	printf '%s\n%s\n%s\n' "$ssid" "$key" "$encryption" >"$temporary" || return 1
	chown 1000:1027 "$temporary" || return 1
	mv "$temporary" "$directory/hotspot.conf"
}

start_service() {
	local enabled nfc infrared nfc_mode
	config_load xm14peripherals
	config_get_bool enabled main enabled 1
	config_get_bool nfc main nfc 1
	config_get_bool infrared main infrared 1
	config_get nfc_mode main nfc_mode share
	case "$nfc_mode" in share|copy) ;; *) nfc_mode=share ;; esac
	[ "$enabled" -eq 1 ] || return 0

	/etc/init.d/xm14pro-binder-managers running ||
		/etc/init.d/xm14pro-binder-managers start
	wait_for_binder_managers || {
		logger -t xm14pro-peripherals 'stock Binder managers are not ready'
		return 1
	}

	if [ "$nfc" -eq 1 ]; then
		/usr/sbin/xm14pro-stock-modules nfc || return 1
	fi
	if [ "$infrared" -eq 1 ]; then
		/usr/sbin/xm14pro-stock-modules infrared || return 1
	fi
	"$PERMISSIONS" || return 1
	[ "$nfc" -eq 0 ] || prepare_hotspot_config || return 1

	[ "$nfc" -eq 1 ] && add_instance nfc nfc
	[ "$nfc" -eq 1 ] && add_instance nfc-service nfc-service "$nfc_mode"
	[ "$infrared" -eq 1 ] && add_instance infrared infrared
}

service_triggers() {
	procd_add_reload_trigger xm14peripherals
}
