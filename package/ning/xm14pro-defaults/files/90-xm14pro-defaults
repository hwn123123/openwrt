#!/bin/sh

uci -q batch <<'EOF'
set system.system='system'
set system.system.hostname='nwrt'
set system.system.zonename='Asia/Shanghai'
set system.system.timezone='CST-8'
set luci.main.lang='zh_cn'
set network.loopback='interface'
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'
set network.globals='globals'
set network.globals.ula_prefix='auto'
set network.usb_lan='interface'
set network.usb_lan.device='usb0'
set network.usb_lan.proto='static'
set network.usb_lan.ipaddr='192.168.66.1'
set network.usb_lan.netmask='255.255.255.0'
set network.wifi_lan='interface'
set network.wifi_lan.proto='static'
set network.wifi_lan.ipaddr='192.168.67.1'
set network.wifi_lan.netmask='255.255.255.0'
set dhcp.usb_lan='dhcp'
set dhcp.usb_lan.interface='usb_lan'
set dhcp.usb_lan.start='100'
set dhcp.usb_lan.limit='50'
set dhcp.usb_lan.leasetime='12h'
set dhcp.usb_lan.dhcpv4='server'
set dhcp.usb_lan.ignore='0'
set dhcp.wifi_lan='dhcp'
set dhcp.wifi_lan.interface='wifi_lan'
set dhcp.wifi_lan.start='100'
set dhcp.wifi_lan.limit='100'
set dhcp.wifi_lan.leasetime='12h'
set dhcp.wifi_lan.dhcpv4='server'
set dhcp.wifi_lan.ignore='0'
commit system
commit luci
commit network
commit dhcp
EOF

# USB is a complete CPE LAN: the host receives its address, router and DNS
# automatically and can use the existing USB-to-cellular forwarding path.
/etc/init.d/dnsmasq enable >/dev/null 2>&1 || true

exit 0
