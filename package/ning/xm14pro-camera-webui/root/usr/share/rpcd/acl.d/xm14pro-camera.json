{
	"xm14pro-camera": {
		"description": "查看并启动摄像头内核驱动",
		"read": {
			"file": {
				"/usr/libexec/xm14pro-camera/read-control": [ "list", "exec" ],
				"/tmp/xm14pro-camera/*": [ "read" ],
				"/mnt/nwrt-data/camera/photos/*": [ "read" ],
				"/mnt/nwrt-data/camera/videos/*": [ "read" ],
				"/mnt/nwrt-data/camera-android-root/data/local/tmp/nwrt-live.jpg": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/usr/libexec/xm14pro-camera/control": [ "list", "exec" ]
			}
		}
	}
}
