#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

MODULE_DIR=/usr/lib/xm14pro/camera-modules
KERNEL=6.1.138-android14-11-g0c3d559bcd85-ab14529422
CAMERA_ROOT=/mnt/nwrt-data/camera-android-root
SNAPSHOT_BIN=/usr/libexec/xm14pro-camera/camera-snapshot
SNAPSHOT_DIR=/tmp/xm14pro-camera
. /usr/share/libubox/jshn.sh

capture_services_ready() {
	[ -x "$SNAPSHOT_BIN" ] && [ -x "$CAMERA_ROOT/system/bin/bootstrap/linker64" ] &&
		[ -e "$CAMERA_ROOT/dev/binder" ] &&
		ps w | grep -q '[c]ameraserver' &&
		ps w | grep -q '[v]endor.qti.camera.provider-service_64'
}

capture_service_signature() {
	local camera_server provider
	camera_server="$(ps w | awk '/[c]ameraserver/ && /bootstrap\/linker64/ {print $1; exit}')"
	provider="$(ps w | awk '/[v]endor.qti.camera.provider-service_64/ && /bootstrap\/linker64/ {print $1; exit}')"
	[ -n "$camera_server" ] && [ -n "$provider" ] || return 1
	printf '%s:%s:%s\n' "$(cat /proc/sys/kernel/random/boot_id)" "$camera_server" "$provider"
}

capture_verified() {
	local signature
	[ -s "$SNAPSHOT_DIR/.verified" ] || return 1
	signature="$(capture_service_signature)" || return 1
	[ "$(cat "$SNAPSHOT_DIR/.verified")" = "$signature" ]
}

add_cameras() {
	json_add_array cameras
	json_add_object ''
	json_add_string id 1
	json_add_string name '前置'
	json_close_object
	json_add_object ''
	json_add_string id 2
	json_add_string name '主摄'
	json_close_object
	json_add_object ''
	json_add_string id 3
	json_add_string name '超广角'
	json_close_object
	json_add_object ''
	json_add_string id 4
	json_add_string name '长焦'
	json_close_object
	json_close_array
}

module_loaded() {
	local name="${1%.ko}"
	name="$(printf '%s' "$name" | tr '-' '_')"
	[ -d "/sys/module/$name" ]
}

count_nodes() {
	local node count=0
	for node in "$1"*; do
		[ -e "$node" ] && count=$((count + 1))
	done
	printf '%s' "$count"
}

ois_firmware_ready() {
	local file
	for file in shennong_tele_bu24618_ois.prog shennong_wide_bu24721_ois_ii.prog shennong_wide_s10_ois.prog; do
		[ -s "/usr/lib/firmware/$file" ] || return 1
	done
	return 0
}

status() {
	local camera=0 cvp=0 firmware=0 eva_firmware=0 ois_firmware=0 media video subdev last_error
	module_loaded camera.ko && camera=1
	[ -e /dev/cvp ] && cvp=1
	[ -s /usr/lib/firmware/CAMERA_ICP.mbn ] && firmware=1
	[ -s /usr/lib/firmware/evass.mbn ] && eva_firmware=1
	ois_firmware_ready && ois_firmware=1
	media="$(count_nodes /dev/media)"
	video="$(count_nodes /dev/video)"
	subdev="$(count_nodes /dev/v4l-subdev)"
	last_error="$(dmesg 2>/dev/null | grep 'CAM_ERR:' | tail -n 1 | cut -c 1-220)"
	json_init
	json_add_boolean ok 1
	json_add_boolean driver_loaded "$camera"
	json_add_boolean cvp_ready "$cvp"
	json_add_boolean firmware_ready "$firmware"
	json_add_boolean eva_firmware_ready "$eva_firmware"
	json_add_boolean ois_firmware_ready "$ois_firmware"
	json_add_int media_nodes "$media"
	json_add_int video_nodes "$video"
	json_add_int subdevices "$subdev"
	if capture_services_ready; then
		json_add_boolean capture_possible 1
		if capture_verified; then
			json_add_boolean capture_ready 1
			json_add_string capture_detail '当前服务已完成真实拍照验证；录像仍在适配'
		else
			json_add_boolean capture_ready 0
			json_add_string capture_detail '相机服务已启动，但本次启动尚未通过真实拍照验证；可尝试拍摄'
		fi
	else
		json_add_boolean capture_possible 0
		json_add_boolean capture_ready 0
		json_add_string capture_detail '相机取流服务未就绪；请检查私有 Android 相机服务'
	fi
	add_cameras
	json_add_string last_kernel_error "$last_error"
	json_dump
}

snapshot() {
	local id="$1" temp output capture_log rc
	case "$id" in
		1|2|3|4) ;;
		*) fail '无效摄像头：可选 1、2、3、4' ;;
	esac
	capture_services_ready || fail '相机取流服务未就绪'
	mkdir -p "$SNAPSHOT_DIR" || fail '无法创建拍照目录'
	chmod 700 "$SNAPSHOT_DIR"
	if ! mkdir "$SNAPSHOT_DIR/.capture-lock" 2>/dev/null; then
		fail '另一张照片正在拍摄，请稍后再试'
	fi
	trap 'rmdir "$SNAPSHOT_DIR/.capture-lock" 2>/dev/null' EXIT INT TERM
	# Run only inside the isolated Android root. Never remount or modify slot A.
	if ! cmp -s "$SNAPSHOT_BIN" "$CAMERA_ROOT/data/local/tmp/xm14pro-camera-snapshot"; then
		cp "$SNAPSHOT_BIN" "$CAMERA_ROOT/data/local/tmp/xm14pro-camera-snapshot" || fail '无法部署拍照程序'
		chmod 755 "$CAMERA_ROOT/data/local/tmp/xm14pro-camera-snapshot"
	fi
	temp="/data/local/tmp/xm14pro-frame-$id.jpg"
	output="$SNAPSHOT_DIR/frame-$id.jpg"
	capture_log="$SNAPSHOT_DIR/capture-$id.log"
	rm -f "$SNAPSHOT_DIR/.verified"
	rm -f "$CAMERA_ROOT$temp" "$output"
	env ANDROID_ROOT=/system ANDROID_DATA=/data ANDROID_I18N_ROOT=/apex/com.android.i18n \
		XM14_PROPERTY_SERVICE_ABSENT=1 XM14_BINDER_MANAGERS_READY=1 \
		LD_LIBRARY_PATH=/apex/com.android.os.statsd/lib64:/apex/com.android.i18n/lib64:/system/lib64:/vendor/lib64:/odm/lib64:/system_ext/lib64 \
		LD_PRELOAD=/system/lib64/libcamera-am-test.so:/system/lib64/libcamera-permission-test.so:/vendor/lib64/libxm14pro_telephony_compat.so:/vendor/lib64/libxm14pro_audio_properties.so \
		timeout 30 chroot "$CAMERA_ROOT" /system/bin/bootstrap/linker64 \
		/data/local/tmp/xm14pro-camera-snapshot "$id" "$temp" >"$capture_log" 2>&1
	rc=$?
	if [ "$rc" -ne 0 ] || [ ! -s "$CAMERA_ROOT$temp" ]; then
		fail "拍照失败（代码 $rc）：$(tail -n 2 "$capture_log" | tr '\n' ' ' | cut -c 1-180)"
	fi
	cp "$CAMERA_ROOT$temp" "$output.tmp" || fail '无法保存照片'
	mv -f "$output.tmp" "$output"
	chmod 600 "$output"
	if capture_service_signature >"$SNAPSHOT_DIR/.verified.tmp"; then
		mv -f "$SNAPSHOT_DIR/.verified.tmp" "$SNAPSHOT_DIR/.verified"
	else
		rm -f "$SNAPSHOT_DIR/.verified.tmp"
	fi
	json_init
	json_add_boolean ok 1
	json_add_string mime image/jpeg
	json_add_string path "$output"
	json_add_string camera "$id"
	json_dump
}

fail() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
	exit 1
}

load_module() {
	local file="$1" output
	module_loaded "$file" && return 0
	[ -r "$MODULE_DIR/$file" ] || fail "缺少原厂模块：$file"
	if ! output="$(/usr/libexec/xm14pro/insmod "$MODULE_DIR/$file" 2>&1)"; then
		logger -t xm14pro-camera "failed to load $file: $output"
		fail "无法加载 $file；请查看系统日志"
	fi
}

case "${1:-status}" in
	status)
		status
		;;
	load)
		[ "$(uname -r)" = "$KERNEL" ] || fail '当前内核版本与摄像头模块不匹配'
		grep -q 'androidboot.slot_suffix = "_b"' /proc/bootconfig 2>/dev/null ||
			fail '当前不是 NWRT 的 B 槽'
		ois_firmware_ready || fail '缺少相机光学防抖固件'
		for file in ipclite.ko smmu_proxy_dlkm.ko synx-driver.ko msm-eva.ko cameralog.ko camera.ko; do
			load_module "$file"
		done
		[ -e /dev/video0 ] || fail '摄像头模块已加载，但设备节点未出现'
		[ -s /usr/lib/firmware/CAMERA_ICP.mbn ] || fail '缺少相机 ICP 固件'
		[ -s /usr/lib/firmware/evass.mbn ] || fail '缺少相机 EVA 固件'
		status
		;;
	snapshot)
		snapshot "${2:-}"
		;;
	*)
		fail '不支持的摄像头操作'
		;;
esac
