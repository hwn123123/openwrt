#!/bin/sh /etc/rc.common

USE_PROCD=1
START=01
STOP=02

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/pcat-sidecar \
		--database /etc/pc_modem.db \
		--telemetry-database /etc/pcat-telemetry.db \
		--telemetry-interval 30 \
		--telemetry-retention-days 7 \
		--listen 127.0.0.1 \
		--port 8092
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
