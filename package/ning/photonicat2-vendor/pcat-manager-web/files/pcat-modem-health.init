#!/bin/sh /etc/rc.common

USE_PROCD=1
START=14
STOP=88

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 \
		/usr/share/pcat-manager-web/pcat_modem_usb.py --boot-guard
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}
