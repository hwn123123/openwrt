#!/bin/sh /etc/rc.common

USE_PROCD=1
START=13
STOP=99

APP_DIR=/usr/share/pcat-manager-web

start_service() {
	# Source files in OpenWrt packages use reproducible epoch timestamps. Remove
	# bytecode left by an older package revision so Python cannot run stale code
	# after an in-place upgrade.
	rm -rf ${APP_DIR}/__pycache__ ${APP_DIR}/pcat_util/__pycache__

	procd_open_instance
	procd_set_param command /usr/bin/python3 \
		${APP_DIR}/pcat-manager-web-main.py -p 80
	procd_set_param env PYTHONPATH=${APP_DIR} PYTHONDONTWRITEBYTECODE=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}
