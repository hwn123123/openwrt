+def _primary_wifi_iface_section(dev_name):
+  preferred = "default_{}".format(dev_name)
+  try:
+    if uci_get("wireless.{}.device".format(preferred)) == dev_name:
+      return preferred
+  except Exception:
+    pass
+  try:
+    result = subprocess.run(
+      ["uci", "-q", "show", "wireless"], capture_output=True, text=True, timeout=5
+    )
+    matcher = re.compile(r"^wireless\.([^.]+)\.device=['\"]?{}['\"]?$".format(re.escape(dev_name)))
+    for line in result.stdout.splitlines():
+      match = matcher.match(line)
+      if match:
+        return match.group(1)
+  except Exception:
+    pass
+  return preferred
