+    def set_sms_notification_callback(self, callback):
+        """Register a lightweight handler for modem +CMTI notifications."""
+        self.sms_notification_callback = callback
+
+    def _handle_unsolicited_line(self, line):
+        line = line.strip()
+        if not line:
+            return False
+        if line.startswith("+CMTI:"):
+            callback = self.sms_notification_callback
+            if callback is not None:
+                try:
+                    callback(line)
+                except Exception as error:
+                    pcat_logger.logger.warning(
+                        "SMS notification callback failed: %s", error)
+            return True
+        return False
+
+    def _read_idle_unsolicited(self):
+        """Consume modem URCs while no AT command is queued.
+
+        Reading an already-buffered unsolicited line sends no command to the
+        modem.  A small carry buffer preserves a line split across reads.
+        """
+        serial_obj = self.serial_obj
+        if serial_obj is None or not getattr(serial_obj, "is_open", False):
+            return
+        if not self.serial_lock.acquire(blocking=False):
+            return
+        try:
+            waiting = serial_obj.in_waiting
+            if waiting <= 0:
+                return
+            self.unsolicited_buffer += serial_obj.read(waiting)
+            parts = self.unsolicited_buffer.split(b"\n")
+            self.unsolicited_buffer = parts.pop() if parts else b""
+            for raw_line in parts:
+                line = raw_line.decode("utf-8", errors="ignore").strip()
+                if not self._handle_unsolicited_line(line):
+                    pcat_logger.logger.debug("Modem URC: %s", line)
+        except Exception as error:
+            pcat_logger.logger.warning("Failed to read modem notification: %s", error)
+        finally:
+            self.serial_lock.release()
+
