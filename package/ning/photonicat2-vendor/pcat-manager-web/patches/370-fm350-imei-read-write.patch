+    def handle_egmrext_set_imei(self, response):
+        """Track completion of the FM350 MediaTek IMEI write command."""
+        text = response.decode("utf-8", errors="ignore")
+        if re.search(r"(?:^|\r?\n)OK(?:\r?\n|$)", text) and not re.search(
+                r"(?:CME\s+)?ERROR", text, re.IGNORECASE):
+            self.basic["imei_write_status"] = "written"
+            self.basic["imei_write_message"] = "写入命令成功，正在回读校验"
+        else:
+            self.basic["imei_write_status"] = "failed"
+            self.basic["imei_write_message"] = "模组拒绝了 IMEI 写入命令"
+        self.basic["imei_write_updated"] = int(time.time())
+
+    def handle_egmrext_imei(self, response):
+        """Parse the FM350 MediaTek ``AT+EGMREXT=0,7`` response."""
+        text = response.decode("utf-8", errors="ignore")
+        match = re.search(r'\+EGMREXT:\s*"(\d{15})"', text)
+        target = str(self.basic.get("imei_write_target", ""))
+        if re.search(r'\+EGMREXT:\s*""', text):
+            self.basic["imei_num"] = ""
+            self.cmd_mark_success("AT+EGMREXT=0,7")
+            if target and self.basic.get("imei_write_status") in (
+                    "pending", "written"):
+                self.basic["imei_write_status"] = "verification_failed"
+                self.basic["imei_write_message"] = "写入后回读仍为空，请核对模组标签号码"
+            else:
+                self.basic["imei_write_status"] = "empty"
+                self.basic["imei_write_message"] = (
+                    "模组已明确返回空 IMEI，请填写模组标签上的原始 15 位号码")
+            self.basic["imei_write_updated"] = int(time.time())
+            return
+
+        if match:
+            imei = match.group(1)
+            self.basic["imei_num"] = imei
+            self.cmd_mark_success("AT+EGMREXT=0,7")
+            if target:
+                if imei == target:
+                    self.basic["imei_write_status"] = "verified"
+                    self.basic["imei_write_message"] = (
+                        "已写入并回读一致，重启模组或设备后完全生效")
+                else:
+                    self.basic["imei_write_status"] = "mismatch"
+                    self.basic["imei_write_message"] = "回读值与提交值不一致"
+                self.basic["imei_write_updated"] = int(time.time())
+            return
+
+        self.cmd_mark_failure("AT+EGMREXT=0,7")
+        if target and self.basic.get("imei_write_status") in (
+                "pending", "written"):
+            self.basic["imei_write_status"] = "verification_failed"
+            self.basic["imei_write_message"] = "写入后仍未读取到 IMEI"
+            self.basic["imei_write_updated"] = int(time.time())
+
