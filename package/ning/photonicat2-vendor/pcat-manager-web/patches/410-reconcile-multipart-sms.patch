+    def _reconcile_sms_mirror(self):
+        """Remove superseded partial rows and transient PDU decode failures.
+
+        This also repairs mirrors created by earlier firmware without touching
+        any physical SIM/modem message.
+        """
+        try:
+            rows = get_rows(
+                self.modem_db_path,
+                "SELECT id, from_num, storage, sent_at, content, raw_json "
+                "FROM sms WHERE direction = 0 AND raw_json IS NOT NULL")
+            groups = {}
+            superseded = set()
+            for row in rows:
+                try:
+                    if (row['from_num'] == '[Decode error]' and
+                            (row['content'] or '').startswith('[PDU decode failed:')):
+                        superseded.add(row['id'])
+                        continue
+                    raw = json.loads(row['raw_json'])
+                    reference = raw.get('reference')
+                    indexes = raw.get('indexes') or [raw.get('index')]
+                    indexes = frozenset(int(index) for index in indexes if index is not None)
+                    if reference is None or not indexes:
+                        continue
+                    key = (row['from_num'], row['storage'], reference)
+                    groups.setdefault(key, []).append((row['id'], indexes, row['content'] or ''))
+                except (TypeError, ValueError, json.JSONDecodeError):
+                    continue
+
+            for entries in groups.values():
+                for old_id, old_indexes, old_content in entries:
+                    if old_content and any(
+                           old_indexes < new_indexes and old_content in new_content
+                           for new_id, new_indexes, new_content in entries
+                           if old_id != new_id):
+                        superseded.add(old_id)
+            for sms_id in superseded:
+                self.exec_sql_param("DELETE FROM sms WHERE id = ?", [sms_id])
+            if superseded:
+                pcat_logger.logger.info(
+                    "Removed %d stale SMS mirror rows", len(superseded))
+            return len(superseded)
+        except sqlite3.Error as error:
+            pcat_logger.logger.error("Failed to reconcile SMS mirror: %s", error)
+            return 0
+
