+@flask_app.route("/api/v1/modem/dial-log/clear.json", methods=['POST'])
+@api_auth_required
+def api_modem_dial_log_clear():
+    """Hide log records before the supplied live-ring offset.
+
+    This does not stop the dialer or alter its in-memory ring.  The marker is
+    tied to the current pcat-manager PID so a restarted manager cannot inherit
+    an offset belonging to an older process.
+    """
+    try:
+        data = request.get_json(force=True) or {}
+        offset = int(data.get("offset"))
+        manager_pid = str(data.get("manager_pid") or "")
+        if offset < 0 or offset > 9223372036854775807:
+            raise ValueError("日志位置无效")
+        result = subprocess.run(
+            ["pidof", "pcat-manager"], capture_output=True, text=True,
+            timeout=2, check=False)
+        active_pid = (result.stdout.strip().split() or [""])[0]
+        if not active_pid or manager_pid != active_pid:
+            return jsonify({
+                "status": "error",
+                "message": "拨号管理进程状态已变化，请刷新后重试",
+            }), 409
+        marker_path = pathlib.Path("/tmp/pcat-modem-log-clear.json")
+        temporary_path = pathlib.Path(str(marker_path) + ".tmp")
+        temporary_path.write_text(json.dumps({
+            "manager_pid": active_pid,
+            "offset": offset,
+            "cleared_at": int(time.time()),
+        }))
+        os.replace(temporary_path, marker_path)
+        return jsonify({"status": "ok", "cleared_before_offset": offset})
+    except (OSError, TypeError, ValueError, subprocess.SubprocessError) as exc:
+        return jsonify({"status": "error", "message": str(exc)}), 400
+
