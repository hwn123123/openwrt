 import pcat_config
 import app
 
+# The vendor module contains extensive development print statements. Keep
+# them available behind the existing debug switch without feeding routine AT
+# traffic into OpenWrt's system log during normal operation.
+_builtin_print = print
+def print(*args, **kwargs):
+    if pcat_config.get_show_debug_logs():
+        _builtin_print(*args, **kwargs)
+
