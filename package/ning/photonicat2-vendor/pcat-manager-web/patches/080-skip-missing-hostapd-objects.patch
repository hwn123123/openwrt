+def _list_hostapd_objects():
+  """Return the hostapd objects currently exported by ubus."""
+  try:
+    output = subprocess.check_output(
+      ["ubus", "list", "hostapd.*"], stderr=subprocess.DEVNULL,
+      timeout=5, text=True
+    )
+    return {line.strip() for line in output.splitlines() if line.strip()}
+  except (OSError, subprocess.SubprocessError):
+    return set()
+
+def _get_hostapd_client_count(iface_names, active_objects):
+  """Return clients from the first matching, currently exported object."""
   for iface in iface_names:
+    # python3-ubus prints "Command failed: Not found" before raising for a
+    # missing object.  Listing once avoids five harmless errors on boards
+    # whose hostapd object follows the newer phyN-apN naming convention.
+    if iface not in active_objects:
+      continue
     result = ubus_call(iface, "get_clients")
     if result and "clients" in result:
       return len(result["clients"])
   return 0
 
