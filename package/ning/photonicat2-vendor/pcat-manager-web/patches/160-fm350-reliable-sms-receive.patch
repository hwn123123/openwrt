+    def _sms_command(self, sms_tool, command, timeout=5):
+        """Run one SMS-session command while serial_lock is held."""
+        responses = sms_tool._send_command_with_sync(command, timeout)
+        for line in responses:
+            if line == "ERROR" or line.startswith(("+CMS ERROR:", "+CME ERROR:")):
+                pcat_logger.logger.warning(
+                    "SMS session command %s failed: %s", command, line)
+                return False, responses
+        return "OK" in responses, responses
+
+    def _ensure_sms_session(self, sms_tool):
+        """Restore volatile 3GPP SMS settings after FM350 radio/USB resets.
+
+        FM350 does not persist CNMI, CPMS, CMGF or CGSMS.  The dialer may
+        legitimately cycle CFUN while recovering the data connection, so check
+        CNMI before every hardware poll and only rewrite the complete session
+        when the modem has reset it.
+        """
+        try:
+            ok, responses = self._sms_command(sms_tool, "AT+CNMI?", 3)
+            compact = "".join("".join(responses).split())
+            if ok and "+CNMI:2,1,0,0,0" in compact:
+                return True
+
+            commands = (
+                "AT+CMEE=2",
+                'AT+CPMS="SM","SM","SM"',
+                "AT+CMGF=0",
+                "AT+CGSMS=1",
+                "AT+CNMI=2,1,0,0,0",
+            )
+            cnmi_ready = False
+            for command in commands:
+                command_ok, _ = self._sms_command(sms_tool, command, 5)
+                if command.startswith("AT+CNMI="):
+                    cnmi_ready = command_ok
+
+            if cnmi_ready:
+                pcat_logger.logger.info(
+                    "SMS receive session initialized on %s",
+                    self.modem_client.modem_tty_path)
+                return True
+
+            pcat_logger.logger.warning("Failed to enable modem SMS reception")
+        except Exception as error:
+            pcat_logger.logger.warning(
+                "Failed to initialize modem SMS session: %s", error)
+        return False
+
