+    def mark_sms_read(self, sms_id=None, hash_id=None):
+        """Mark a received SMS as read in the vendor database.
+
+        The FM350 path stores messages in SQLite after fetching them from the
+        modem.  PcModemClient has no read_sms method in this revision, so a
+        read operation must update the local record instead of calling a
+        missing modem API.
+        """
+        try:
+            if sms_id is not None:
+                self.exec_sql_param(
+                    "UPDATE sms SET status = 'REC READ' "
+                    "WHERE id = ? AND direction = 0", [int(sms_id)])
+            elif hash_id:
+                self.exec_sql_param(
+                    "UPDATE sms SET status = 'REC READ' "
+                    "WHERE hash_digest = ? AND direction = 0", [str(hash_id)])
+            else:
+                return False
+            return True
+        except (TypeError, ValueError, sqlite3.Error) as e:
+            pcat_logger.logger.error("Failed to mark SMS read: %s", e)
+            return False
+
+    def get_topic_messages(self, topic=None, sms_id=None):
+        """Return conversation rows in the format used by the vendor modal."""
+        try:
+            if topic:
+                rows = get_rows(self.modem_db_path,
+                                "SELECT * FROM sms WHERE topic = ? "
+                                "ORDER BY created_at ASC", (str(topic),))
+            elif sms_id is not None:
+                rows = get_rows(self.modem_db_path,
+                                "SELECT * FROM sms WHERE id = ?", (int(sms_id),))
+            else:
+                rows = []
+
+            messages = []
+            for row in rows:
+                item = {k: row[k] for k in row.keys()}
+                raw = item.get("raw_json")
+                if raw:
+                    try:
+                        parsed = json.loads(raw)
+                        if isinstance(parsed, dict):
+                            item.update(parsed)
+                    except (TypeError, ValueError, json.JSONDecodeError):
+                        pass
+                sender = item.get("sender") or item.get("from_num") or ""
+                content = item.get("content") or item.get("msg") or ""
+                timestamp = (item.get("timestamp") or item.get("send_at") or
+                             item.get("sent_at") or item.get("created_at") or "")
+                messages.append({
+                    "id": item.get("id"),
+                    "storage": item.get("storage") or "ME",
+                    "from": "me" if item.get("direction") == 1 else sender,
+                    "to": item.get("to") or item.get("to_num") or "",
+                    "msg": content,
+                    "content": content,
+                    "send_at": timestamp,
+                    "timestamp": timestamp,
+                    "status": item.get("status") or "",
+                    "direction": item.get("direction", 0),
+                })
+            return messages
+        except (TypeError, ValueError, sqlite3.Error) as e:
+            pcat_logger.logger.error("Failed to read SMS conversation: %s", e)
+            return []

