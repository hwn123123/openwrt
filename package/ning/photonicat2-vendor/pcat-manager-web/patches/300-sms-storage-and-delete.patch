+@api_auth_required
+@flask_app.route("/api/v1/modem/sms/storage.json", methods=['GET', 'POST'])
+def api_sms_storage():
+    """Read or change the modem's preferred incoming SMS storage."""
+    if request.method == 'GET':
+        return jsonify({"status": "ok", **pc_app.sms_client.get_sms_storage()})
+    data = request.get_json(silent=True) or {}
+    storage = str(data.get("storage") or "").upper()
+    if storage not in ("SM", "ME"):
+        return jsonify({"status": "error", "message": "storage must be SM or ME"}), 400
+    if not pc_app.sms_client.set_sms_storage(storage):
+        return jsonify({"status": "error", "message": "模组未确认短信存储设置"}), 503
+    invalidate_sms_cache()
+    return jsonify({"status": "ok", **pc_app.sms_client.get_sms_storage()})
+
