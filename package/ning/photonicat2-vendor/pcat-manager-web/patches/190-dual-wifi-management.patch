+def get_wifi_radio_mapping():
+  """Return the UCI radio names for (onboard USB, external PCIe).
+
+  The vendor firmware historically assumed radio0 was onboard.  On current
+  NWRT images radio0 is the MT7927 PCIe card and radio1 is the onboard USB
+  radio, so radio numbers must be resolved from their configured PHY/path.
+  """
+  usb_phy, pcie_phy = get_wifi_phy_mapping()
+  usb_radio = None
+  pcie_radio = None
+  for index in range(4):
+    radio = "radio{}".format(index)
+    try:
+      configured_phy = uci_get("wireless.{}.phy".format(radio))
+    except Exception:
+      configured_phy = ""
+    try:
+      configured_path = uci_get("wireless.{}.path".format(radio)).lower()
+    except Exception:
+      configured_path = ""
+
+    if configured_phy and configured_phy == usb_phy:
+      usb_radio = radio
+    elif configured_phy and configured_phy == pcie_phy:
+      pcie_radio = radio
+    elif "usb" in configured_path:
+      usb_radio = radio
+    elif "pcie" in configured_path or "/pci" in configured_path:
+      pcie_radio = radio
+
+  # Match the common radioN == phyN convention only as a final fallback.
+  if usb_phy and not usb_radio and usb_phy.startswith("phy"):
+    usb_radio = "radio{}".format(usb_phy[3:])
+  if pcie_phy and not pcie_radio and pcie_phy.startswith("phy"):
+    pcie_radio = "radio{}".format(pcie_phy[3:])
+  return usb_radio, pcie_radio
+
