 @api_auth_required
+@flask_app.route("/sound_events")
+def sound_events_page():
+    if 'username' not in session:
+        return redirect(f"/login?next={request.path}")
+    return render_template("sound_events.html", locales=base_locales())
+
+@api_auth_required
+@flask_app.route("/api/v1/sound_events.json", methods=['GET'])
+def sound_events_api():
+    if pc_app.sound_events is None:
+        return jsonify({"status": "error", "message": "事件监测服务尚未启动"}), 503
+    return jsonify(pc_app.sound_events.snapshot())
+
+@api_auth_required
+@flask_app.route("/api/v1/sound_events.json", methods=['POST'])
+def save_sound_events_api():
+    if pc_app.sound_events is None:
+        return jsonify({"status": "error", "message": "事件监测服务尚未启动"}), 503
+    try:
+        data = request.get_json(force=True) or {}
+        return jsonify(pc_app.sound_events.save(data))
+    except (TypeError, ValueError, OSError) as exc:
+        return jsonify({"status": "error", "message": str(exc)}), 400
+
+@api_auth_required
+@flask_app.route("/api/v1/sound_events/preview.json", methods=['POST'])
+def preview_sound_event_api():
+    if pc_app.sound_events is None:
+        return jsonify({"status": "error", "message": "事件监测服务尚未启动"}), 503
+    try:
+        data = request.get_json(force=True) or {}
+        ok, message = pc_app.sound_events.preview(data.get("sound"), data.get("tones"))
+        if not ok:
+            return jsonify({"status": "error", "message": message}), 409
+        return jsonify({"status": "ok"})
+    except (TypeError, ValueError, OSError) as exc:
+        return jsonify({"status": "error", "message": str(exc)}), 400
+
