+    try:
+      kernel_ver = subprocess.check_output(["uname", "-r"], encoding="utf-8").strip()
+      kernel_date_str = subprocess.check_output(["uname", "-v"], encoding="utf-8").strip()
+      # The vendor kernel uses strings such as "#0 SMP PREEMPT Wed Jul 2
+      # 09:59:17 2025". NWRT can omit PREEMPT or the weekday, so do not
+      # index fixed positions in uname output.
+      date_match = re.search(
+        r"\b([A-Z][a-z]{2})\s+(\d{1,2})\s+\d{2}:\d{2}:\d{2}\s+\S+\s+(\d{4})\b",
+        kernel_date_str,
+      )
+      if date_match:
+        kernel_date = "{} {} {}".format(
+          date_match.group(1), int(date_match.group(2)), date_match.group(3)
+        )
+        board_info["kernel"] = kernel_ver + " - " + kernel_date
+      else:
+        board_info["kernel"] = kernel_ver
+    except (OSError, subprocess.SubprocessError, ValueError):
+      # A missing/unusual uname implementation must not prevent the web UI
+      # from starting; the kernel release alone is still useful to display.
+      board_info["kernel"] = locals().get("kernel_ver", "unknown")
     self.board_info = board_info
