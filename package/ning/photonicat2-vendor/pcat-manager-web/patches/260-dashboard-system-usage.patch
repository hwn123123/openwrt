+@flask_app.route("/api/v1/modem/runtime.json", methods=['GET'])
+@api_auth_required
+def modem_runtime_json():
+    """Read the detected modem's own runtime only while a UI requests it."""
+    runtime = _dashboard_modem_sampler.read()
+    basic = pc_app.modem_client.basic
+    temperature = runtime.get("temperature")
+    if temperature in (None, ""):
+        temperature = basic.get("modem_temperature_decimal")
+    if temperature in (None, ""):
+        sensors = basic.get("qtemp_sensors") or {}
+        if isinstance(sensors, dict):
+            for value in sensors.values():
+                try:
+                    temperature = float(value)
+                    break
+                except (TypeError, ValueError):
+                    continue
+    try:
+        runtime["temperature"] = (None if temperature in (None, "")
+                                  else float(temperature))
+    except (TypeError, ValueError):
+        runtime["temperature"] = None
+    thermal_sensors = (runtime.get("thermal_sensors") or
+                       basic.get("fm350_temperature_sensors") or {})
+    runtime["thermal_sensors"] = (thermal_sensors
+                                  if isinstance(thermal_sensors, dict) else {})
+    runtime["model"] = basic.get("model", "")
+    response = jsonify(runtime)
+    response.headers["Cache-Control"] = "no-store"
+    return response
