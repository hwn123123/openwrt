+@flask_app.route("/api/v1/telemetry/history.json", methods=['GET'])
+@api_auth_required
+def telemetry_history_json():
+    """Proxy the loopback-only persistent telemetry store to logged-in users."""
+    range_name = request.args.get("range", "3h")
+    if range_name not in ("3h", "24h", "7d"):
+        return jsonify({"status": "error", "message": "Unsupported range"}), 400
+
+    query = urllib.parse.urlencode({"range": range_name})
+    url = "http://127.0.0.1:8092/v1/telemetry?" + query
+    try:
+        internal_request = urllib.request.Request(url, headers={
+            "User-Agent": "pcat-manager-web/telemetry-proxy",
+            "Cache-Control": "no-cache",
+        })
+        with urllib.request.urlopen(internal_request, timeout=6.0) as response:
+            payload = response.read(2 * 1024 * 1024)
+            if response.status != 200:
+                raise urllib.error.HTTPError(
+                    url, response.status, "telemetry error",
+                    response.headers, None
+                )
+        rsp = make_response(payload)
+        rsp.headers["Content-Type"] = "application/json; charset=utf-8"
+        rsp.headers["Cache-Control"] = "no-store"
+        return rsp
+    except (urllib.error.HTTPError, urllib.error.URLError,
+            OSError, TimeoutError) as error:
+        pcat_logger.logger.warning(
+            "Telemetry sidecar unavailable: %s", type(error).__name__)
+        return jsonify({"status": "error", "message": "Telemetry unavailable"}), 503
+
