+/* Publish the data-plane lifecycle for secondary AT consumers.  The Web/SMS
+ * process waits while this file reports an active dial phase, so the first
+ * network session cannot be starved by telemetry. */
+static void dial_state_write(const char *state, int code)
+{
+    char tmp_path[sizeof(DIAL_STATE_PATH) + 32];
+    FILE *fp;
+
+    if(strcmp(g_dial_state, state)==0)
+    {
+        return;
+    }
+
+    snprintf(tmp_path, sizeof(tmp_path), "%s.%ld", DIAL_STATE_PATH,
+        (long)getpid());
+    fp = fopen(tmp_path, "w");
+    if(fp==NULL)
+    {
+        fprintf(stderr, "Cannot publish dial state %s: %s\n", state,
+            strerror(errno));
+        return;
+    }
+
+    fprintf(fp,
+        "{\"state\":\"%s\",\"attempt\":%d,\"code\":%d,"
+        "\"pid\":%ld,\"updated\":%ld}\n",
+        state, g_dial_attempt, code, (long)getpid(), (long)time(NULL));
+    if(fflush(fp)!=0 || fsync(fileno(fp))!=0 || fclose(fp)!=0 ||
+       rename(tmp_path, DIAL_STATE_PATH)!=0)
+    {
+        fprintf(stderr, "Cannot install dial state %s: %s\n", state,
+            strerror(errno));
+        unlink(tmp_path);
+        return;
+    }
+
+    snprintf(g_dial_state, sizeof(g_dial_state), "%s", state);
+}
+
+static int device_cache_valid(void)
+{
+    FILE *fp;
+    char buf[256];
+    size_t n;
+
+    fp = fopen(DEVICE_CACHE_PATH, "r");
+    if(fp==NULL)
+    {
+        return 0;
+    }
+    n = fread(buf, 1, sizeof(buf) - 1, fp);
+    fclose(fp);
+    buf[n] = '\0';
+
+    return strstr(buf, "\"model\":\"FM350")!=NULL &&
+        strstr(buf, "\"usb_id\":\"0e8d:7127\"")!=NULL &&
+        strstr(buf, "\"at_interface\":\"06\"")!=NULL;
+}
+
+static void device_cache_write(void)
+{
+    char tmp_path[sizeof(DEVICE_CACHE_PATH) + 32];
+    FILE *fp;
+
+    snprintf(tmp_path, sizeof(tmp_path), "%s.%ld", DEVICE_CACHE_PATH,
+        (long)getpid());
+    fp = fopen(tmp_path, "w");
+    if(fp==NULL)
+    {
+        return;
+    }
+    fputs("{\"model\":\"FM350\",\"usb_id\":\"0e8d:7127\","
+        "\"at_interface\":\"06\"}\n", fp);
+    if(fflush(fp)!=0 || fsync(fileno(fp))!=0 || fclose(fp)!=0 ||
+       rename(tmp_path, DEVICE_CACHE_PATH)!=0)
+    {
+        unlink(tmp_path);
+    }
+}
