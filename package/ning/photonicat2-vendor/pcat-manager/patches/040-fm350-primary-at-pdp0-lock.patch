+    while(flock(g_at_lock_fd, LOCK_EX)!=0)
+    {
+        if(errno!=EINTR)
+        {
+            fprintf(stderr, "Failed to acquire AT lock: %s\n",
+                strerror(errno));
+            return -1;
+        }
+    }
+
+    return 0;
+}
