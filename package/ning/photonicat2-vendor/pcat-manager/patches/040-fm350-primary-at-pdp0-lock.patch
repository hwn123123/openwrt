+/* The stock FM350 USB composition exposes its primary application AT port on
+ * USB interface 06 (normally /dev/ttyUSB3). Prefer the interface number over
+ * the tty ordinal because ttyUSB numbers can move after re-enumeration. */
+static int port_interface_number(const char *port)
+{
+    const char *name = strrchr(port, '/');
+    char path[256];
+    unsigned int number;
+    FILE *fp;
+
+    name = (name!=NULL) ? name + 1 : port;
+    snprintf(path, sizeof(path),
+        "/sys/class/tty/%s/device/../bInterfaceNumber", name);
+    fp = fopen(path, "r");
+    if(fp==NULL)
+    {
+        return -1;
+    }
+    if(fscanf(fp, "%x", &number)!=1)
+    {
+        fclose(fp);
+        return -1;
+    }
+    fclose(fp);
+
+    return (int)number;
+}
+
+static void prefer_primary_at_port(char ports[][64], int port_count)
+{
+    int i;
+    char preferred[64];
+
+    for(i=0;i<port_count;i++)
+    {
+        if(port_interface_number(ports[i])==0x06)
+        {
+            if(i==0)
+            {
+                return;
+            }
+            snprintf(preferred, sizeof(preferred), "%s", ports[i]);
+            memmove(&ports[1], &ports[0], (size_t)i * sizeof(ports[0]));
+            snprintf(ports[0], sizeof(ports[0]), "%s", preferred);
+            return;
+        }
+    }
+}
