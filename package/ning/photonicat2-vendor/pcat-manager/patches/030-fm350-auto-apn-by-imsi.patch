+/* Return the first response line made entirely of digits. This is used for
+ * AT+CIMI, whose payload is the IMSI followed by the final OK line. */
+static int response_digits_line(const char *buf, char *out, size_t outsz)
+{
+    const char *p = buf;
+
+    while(*p!='\0')
+    {
+        const char *start;
+        const char *end;
+        const char *q;
+        size_t len;
+
+        while(*p=='\r' || *p=='\n' || isspace((unsigned char)*p))
+        {
+            p++;
+        }
+        start = p;
+        while(*p!='\0' && *p!='\r' && *p!='\n')
+        {
+            p++;
+        }
+        end = p;
+        while(end > start && isspace((unsigned char)*(end - 1)))
+        {
+            end--;
+        }
+        len = (size_t)(end - start);
+        if(len >= 5 && len < outsz)
+        {
+            for(q=start;q<end && isdigit((unsigned char)*q);q++);
+            if(q==end)
+            {
+                memcpy(out, start, len);
+                out[len] = '\0';
+                return 0;
+            }
+        }
+    }
+
+    return -1;
+}
+
+static int apn_valid(const char *apn)
+{
+    const unsigned char *p = (const unsigned char *)apn;
+    size_t len = strlen(apn);
+
+    if(len==0 || len > APN_MAX_LEN)
+    {
+        return 0;
+    }
+    for(;*p!='\0';p++)
+    {
+        if(!isalnum(*p) && *p!='.' && *p!='-')
+        {
+            return 0;
+        }
+    }
+
+    return 1;
+}
+
+/* Look up the longest IMSI/PLMN prefix in the user-editable profile file.
+ * Each non-comment line is: PREFIX APN CARRIER. The carrier label is optional
+ * and is used only in the log. Longest-prefix matching permits a private or
+ * MVNO profile to override a five-digit national operator entry. */
+static int apn_profile_lookup(const char *identity, char *apn, size_t apnsz,
+    char *carrier, size_t carriersz)
+{
+    FILE *fp;
+    char line[256];
+    char prefix[32], candidate[APN_MAX_LEN + 1], label[128];
+    size_t best = 0;
+
+    fp = fopen(APN_PROFILE_PATH, "r");
+    if(fp==NULL)
+    {
+        fprintf(stderr, "Cannot open APN profile %s: %s\n",
+            APN_PROFILE_PATH, strerror(errno));
+        return -1;
+    }
+
+    apn[0] = '\0';
+    carrier[0] = '\0';
+    while(fgets(line, sizeof(line), fp)!=NULL)
+    {
+        char *p = line;
+        char *end;
+        size_t prefix_len;
+
+        while(isspace((unsigned char)*p))
+        {
+            p++;
+        }
+        if(*p=='\0' || *p=='#')
+        {
+            continue;
+        }
+
+        label[0] = '\0';
+        if(sscanf(p, "%31s %100s %127[^\r\n]", prefix, candidate,
+            label) < 2 || !apn_valid(candidate))
+        {
+            continue;
+        }
+        prefix_len = strlen(prefix);
+        if(prefix_len <= best || strncmp(identity, prefix, prefix_len)!=0)
+        {
+            continue;
+        }
+        for(end=prefix;*end!='\0' && isdigit((unsigned char)*end);end++);
+        if(*end!='\0')
+        {
+            continue;
+        }
+        while(isspace((unsigned char)*label))
+        {
+            memmove(label, label + 1, strlen(label));
+        }
+
+        snprintf(apn, apnsz, "%s", candidate);
+        snprintf(carrier, carriersz, "%s", label);
+        best = prefix_len;
+    }
+    fclose(fp);
+
+    return best > 0 ? 0 : -1;
+}
+
+static int serving_plmn(int fd, char *plmn, size_t plmnsz)
+{
+    char resp[AT_RESP_MAX];
+    char line[256];
+    const char *p;
+
+    if(at_cmd(fd, "AT+COPS=3,2", resp, sizeof(resp), 5000)!=1 ||
+       at_cmd(fd, "AT+COPS?", resp, sizeof(resp), 5000)!=1 ||
+       get_line_after(resp, "+COPS: ", line, sizeof(line))!=0 ||
+       field_get(line, 2, plmn, plmnsz)!=0)
+    {
+        return -1;
+    }
+
+    if(strlen(plmn)!=5 && strlen(plmn)!=6)
+    {
+        return -1;
+    }
+    for(p=plmn;*p!='\0' && isdigit((unsigned char)*p);p++);
+
+    return *p=='\0' ? 0 : -1;
+}
+
+/* Manual APN wins. An empty APN means real automatic selection from the SIM
+ * home identity, with the currently serving PLMN as a fallback only. */
+static int resolve_apn(int fd, const char *configured, char *apn, size_t apnsz)
+{
+    char resp[AT_RESP_MAX];
+    char imsi[32] = "";
+    char plmn[16] = "";
+    char carrier[128] = "";
+
+    if(configured!=NULL && configured[0]!='\0')
+    {
+        if(!apn_valid(configured))
+        {
+            fprintf(stderr, "Configured APN contains invalid characters.\n");
+            return -1;
+        }
+        snprintf(apn, apnsz, "%s", configured);
+        fprintf(stderr, "APN source: manual, selected APN: %s\n", apn);
+        return 0;
+    }
+
+    if(at_cmd(fd, "AT+CIMI", resp, sizeof(resp), 5000)==1 &&
+       response_digits_line(resp, imsi, sizeof(imsi))==0 &&
+       apn_profile_lookup(imsi, apn, apnsz, carrier, sizeof(carrier))==0)
+    {
+        fprintf(stderr, "APN source: SIM IMSI, IMSI prefix %.6s%s%s, selected APN: %s\n",
+            imsi, carrier[0]!='\0' ? ", carrier: " : "", carrier, apn);
+        return 0;
+    }
+
+    if(serving_plmn(fd, plmn, sizeof(plmn))==0 &&
+       apn_profile_lookup(plmn, apn, apnsz, carrier, sizeof(carrier))==0)
+    {
+        fprintf(stderr, "APN source: serving PLMN fallback, PLMN %s%s%s, "
+            "selected APN: %s\n", plmn,
+            carrier[0]!='\0' ? ", carrier: " : "", carrier, apn);
+        return 0;
+    }
+
+    apn[0] = '\0';
+    fprintf(stderr, "APN source: automatic; no profile matched, using only "
+        "the modem's operator-assigned initial context.\n");
+    return 0;
+}
