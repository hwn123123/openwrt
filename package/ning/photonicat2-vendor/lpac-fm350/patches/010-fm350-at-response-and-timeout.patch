+static int at_read_line(char *line, size_t size, time_t deadline) {
+    size_t used = 0;
+    int fd = fileno(fuart);
+
+    while (time(NULL) < deadline) {
+        fd_set readfds;
+        struct timeval wait = { .tv_sec = 0, .tv_usec = 500000 };
+        FD_ZERO(&readfds);
+        FD_SET(fd, &readfds);
+        if (select(fd + 1, &readfds, NULL, NULL, &wait) <= 0)
+            continue;
+        char character;
+        ssize_t count = read(fd, &character, 1);
+        if (count <= 0) {
+            usleep(10000);
+            continue;
+        }
+        if (character == '\r' || character == '\n') {
+            if (!used)
+                continue;
+            line[used] = 0;
+            return 0;
+        }
+        if (used + 1 < size)
+            line[used++] = character;
+    }
+    return -1;
+}
 
