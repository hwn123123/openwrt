+// ModemStringList accepts both the legacy comma-separated string returned by
+// older pcat-manager builds and the JSON array returned by current builds.
+// Keeping a single normalized string prevents an API shape change from
+// stopping the display's entire modem-data update.
+type ModemStringList string
+
+func (value *ModemStringList) UnmarshalJSON(data []byte) error {
+	var text string
+	if err := secureUnmarshal(data, &text); err == nil {
+		*value = ModemStringList(text)
+		return nil
+	}
+
+	var values []interface{}
+	if err := secureUnmarshal(data, &values); err != nil {
+		return err
+	}
+	parts := make([]string, 0, len(values))
+	for _, item := range values {
+		parts = append(parts, fmt.Sprint(item))
+	}
+	*value = ModemStringList(strings.Join(parts, ","))
+	return nil
+}
