+// ModemTemperature tolerates the vendor API's boot-time placeholder string
+// (usually "N/A") as well as its normal object form. Rejecting that one field
+// used to discard the entire modem status response during startup.
+type ModemTemperature map[string]int
+
+func (mt *ModemTemperature) UnmarshalJSON(data []byte) error {
+	value := strings.TrimSpace(string(data))
+	if value == "" || value == "null" || strings.HasPrefix(value, "\"") {
+		*mt = nil
+		return nil
+	}
+
+	var raw map[string]interface{}
+	if err := secureUnmarshal(data, &raw); err != nil {
+		return err
+	}
+	parsed := make(ModemTemperature, len(raw))
+	for name, value := range raw {
+		switch number := value.(type) {
+		case float64:
+			parsed[name] = int(number)
+		case string:
+			if n, err := strconv.ParseFloat(strings.TrimSpace(number), 64); err == nil {
+				parsed[name] = int(n)
+			}
+		}
+	}
+	*mt = parsed
+	return nil
+}
+
