@@ -0,0 +1,34 @@
+package main
+
+import "testing"
+
+func TestModemTemperatureAcceptsBootPlaceholderAndObject(t *testing.T) {
+	tests := []struct {
+		name string
+		json string
+		want int
+	}{
+		{name: "placeholder", json: `{"modem_temperature":"N/A"}`, want: 0},
+		{name: "null", json: `{"modem_temperature":null}`, want: 0},
+		{name: "object", json: `{"modem_temperature":{"ambient":48,"pa":"42.9"}}`, want: 2},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var got ModemBasicInfo
+			if err := secureUnmarshal([]byte(tc.json), &got); err != nil {
+				t.Fatalf("secureUnmarshal: %v", err)
+			}
+			if len(got.ModemTemperature) != tc.want {
+				t.Fatalf("temperature count = %d, want %d", len(got.ModemTemperature), tc.want)
+			}
+		})
+	}
+}
+
+func TestModemTemperatureRejectsInvalidContainer(t *testing.T) {
+	var got ModemBasicInfo
+	if err := secureUnmarshal([]byte(`{"modem_temperature":[48]}`), &got); err == nil {
+		t.Fatal("array temperature unexpectedly accepted")
+	}
+}
