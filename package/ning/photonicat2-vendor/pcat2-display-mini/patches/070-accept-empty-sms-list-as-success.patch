@@ -0,0 +1,23 @@
+package main
+
+import "testing"
+
+func TestIsValidSmsResponseAcceptsEmptyInbox(t *testing.T) {
+	if !isValidSmsResponse(`{"msg":[]}`) {
+		t.Fatal("an empty SMS list is a successful sidecar response")
+	}
+}
+
+func TestIsValidSmsResponseAcceptsMessages(t *testing.T) {
+	if !isValidSmsResponse(`{"msg":[{"id":1,"content":"test"}]}`) {
+		t.Fatal("a populated SMS list must be accepted")
+	}
+}
+
+func TestIsValidSmsResponseRejectsInvalidPayloads(t *testing.T) {
+	for _, payload := range []string{"", `{}`, `{"msg":null}`, `{"msg":"bad"}`, `{bad`} {
+		if isValidSmsResponse(payload) {
+			t.Fatalf("invalid SMS response accepted: %q", payload)
+		}
+	}
+}
