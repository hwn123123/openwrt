+// isValidSmsResponse validates the sidecar contract rather than using the
+// response byte length as a proxy for success.  An empty inbox is returned as
+// {"msg":[]} (exactly ten bytes) and is a perfectly successful response.
+func isValidSmsResponse(content string) bool {
+	var envelope map[string]interface{}
+	if content == "" || secureUnmarshal([]byte(content), &envelope) != nil {
+		return false
+	}
+	messages, exists := envelope["msg"]
+	if !exists {
+		return false
+	}
+	_, isArray := messages.([]interface{})
+	return isArray
+}
