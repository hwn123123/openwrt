+++ b/smsNotification_test.go
@@ -0,0 +1,33 @@
+package main
+
+import "testing"
+
+func TestObserveReceivedSmsOnlyNotifiesForNewIncoming(t *testing.T) {
+	oldInitialized := smsNotificationInitialized
+	oldSeen := seenReceivedSms
+	t.Cleanup(func() {
+		smsNotificationInitialized = oldInitialized
+		seenReceivedSms = oldSeen
+	})
+
+	smsNotificationInitialized = false
+	seenReceivedSms = make(map[string]struct{})
+
+	baseline := `{"msg":[{"id":1,"sender":"10086","timestamp":"2026-09-06 12:00:00","content":"old","direction":0}]}`
+	if observeReceivedSms(baseline) {
+		t.Fatal("initial baseline must not notify")
+	}
+
+	sentAdded := `{"msg":[{"id":2,"sender":"me","timestamp":"2026-09-06 12:01:00","content":"sent","direction":1},{"id":1,"sender":"10086","timestamp":"2026-09-06 12:00:00","content":"old","direction":0}]}`
+	if observeReceivedSms(sentAdded) {
+		t.Fatal("sent SMS must not notify")
+	}
+
+	incomingAdded := `{"msg":[{"id":3,"sender":"10086","timestamp":"2026-09-06 12:02:00","content":"new","direction":0},{"id":1,"sender":"10086","timestamp":"2026-09-06 12:00:00","content":"old","direction":0}]}`
+	if !observeReceivedSms(incomingAdded) {
+		t.Fatal("new received SMS must notify")
+	}
+	if observeReceivedSms(incomingAdded) {
+		t.Fatal("the same received SMS must notify only once")
+	}
+}
