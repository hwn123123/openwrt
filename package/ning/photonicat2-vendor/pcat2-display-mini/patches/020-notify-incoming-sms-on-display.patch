+// signalSmsNotification wakes the render loop without blocking the SMS
+// collector. Multiple messages arriving in one modem poll are intentionally
+// coalesced into one jump to the SMS page.
+func signalSmsNotification() {
+	select {
+	case smsNotificationSignal <- struct{}{}:
+		signalPageChange()
+	default:
+	}
+}
+
+// observeReceivedSms reports whether a valid API response contains a received
+// message not seen in an earlier successful poll. Sent messages (direction 1)
+// never wake the display. IDs are preferred; older vendor APIs without IDs
+// fall back to stable message fields.
+func observeReceivedSms(jsonContent string) bool {
+	var data struct {
+		Msg []SMS `json:"msg"`
+	}
+	if jsonContent == "" || secureUnmarshal([]byte(jsonContent), &data) != nil {
+		return false
+	}
+
+	keys := make([]string, 0, len(data.Msg))
+	for _, sms := range data.Msg {
+		if sms.Direction == 1 {
+			continue
+		}
+		key := ""
+		if sms.ID > 0 {
+			key = "id:" + strconv.Itoa(sms.ID)
+		} else {
+			key = fmt.Sprintf("msg:%s\x00%s\x00%s", sms.Sender, sms.Timestamp, sms.Content)
+		}
+		keys = append(keys, key)
+	}
+
+	if !smsNotificationInitialized {
+		for _, key := range keys {
+			seenReceivedSms[key] = struct{}{}
+		}
+		smsNotificationInitialized = true
+		return false
+	}
+
+	newMessage := false
+	for _, key := range keys {
+		if _, ok := seenReceivedSms[key]; !ok {
+			seenReceivedSms[key] = struct{}{}
+			newMessage = true
+		}
+	}
+	return newMessage
+}
