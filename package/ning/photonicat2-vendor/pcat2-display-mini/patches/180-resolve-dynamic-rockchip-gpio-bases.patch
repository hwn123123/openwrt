+// resolveRockchipGPIO translates the stable Rockchip bank-based number used
+// by the board schematic (bank*32 + offset) to the Linux global GPIO number.
+// Older kernels assigned gpio0 a base of zero, while newer kernels allocate
+// dynamic bases (commonly starting at 512), so hard-coding "GPIO122" is no
+// longer valid. Keep the legacy lookup first so one binary works on both.
+func resolveRockchipGPIO(logical int) (gpio.PinOut, error) {
+	legacyName := fmt.Sprintf("GPIO%d", logical)
+	if pin := gpioreg.ByName(legacyName); pin != nil {
+		return pin, nil
+	}
+
+	bank := logical / 32
+	offset := logical % 32
+	chipPaths, err := filepath.Glob("/sys/class/gpio/gpiochip*")
+	if err != nil {
+		return nil, fmt.Errorf("enumerate GPIO controllers: %w", err)
+	}
+	wantedLabel := fmt.Sprintf("gpio%d", bank)
+	for _, chipPath := range chipPaths {
+		labelData, err := os.ReadFile(filepath.Join(chipPath, "label"))
+		if err != nil || strings.TrimSpace(string(labelData)) != wantedLabel {
+			continue
+		}
+		baseData, err := os.ReadFile(filepath.Join(chipPath, "base"))
+		if err != nil {
+			return nil, fmt.Errorf("read %s base: %w", wantedLabel, err)
+		}
+		base, err := strconv.Atoi(strings.TrimSpace(string(baseData)))
+		if err != nil {
+			return nil, fmt.Errorf("parse %s base: %w", wantedLabel, err)
+		}
+		dynamicName := fmt.Sprintf("GPIO%d", base+offset)
+		pin := gpioreg.ByName(dynamicName)
+		if pin == nil {
+			return nil, fmt.Errorf("%s maps to unregistered %s", legacyName, dynamicName)
+		}
+		log.Printf("GPIO mapping: %s -> %s (%s offset %d)", legacyName, dynamicName, wantedLabel, offset)
+		return pin, nil
+	}
+	return nil, fmt.Errorf("GPIO controller %s not found for %s", wantedLabel, legacyName)
+}
