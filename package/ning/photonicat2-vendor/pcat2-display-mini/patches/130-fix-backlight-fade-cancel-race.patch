+func TestUtilCovCancelledFadeCannotOverwriteForcedOff(t *testing.T) {
+	p := utilCovFadeSetup(t, "100")
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		fadeBacklight(0, 2*time.Second)
+	}()
+
+	time.Sleep(60 * time.Millisecond) // allow the old fade to enter its loop
+	fadeMu.Lock()
+	close(fadeCancel)
+	fadeCancel = make(chan struct{})
+	fadeMu.Unlock()
+
+	// This is the IDLE transition's authoritative write.  No step belonging
+	// to the cancelled fade may land after it.
+	setBacklight(0)
+
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cancelled fade did not exit")
+	}
+	time.Sleep(50 * time.Millisecond)
+	if got := utilCovReadFile(t, p); got != "0" {
+		t.Errorf("cancelled fade overwrote forced off: brightness = %q", got)
 	}
 }
 
