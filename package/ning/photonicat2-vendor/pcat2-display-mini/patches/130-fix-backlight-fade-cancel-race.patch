+func TestUtilCovSetBacklightRepairsPhysicalDrift(t *testing.T) {
+	p := utilCovSetBacklightFile(t, "100")
+	utilCovSaveBacklightState(t)
+	utilCovSaveCfg(t)
+	cfg.ScreenMinBrightness = 0
+	cfg.ScreenMaxBrightness = 100
+
+	// Reproduce the field failure: the state machine believes the display is
+	// off, while the PWM node has drifted back to full brightness.
+	mu.Lock()
+	lastLogical = 0
+	offTimer = nil
+	mu.Unlock()
+
+	setBacklight(0)
+	if got := utilCovReadFile(t, p); got != "0" {
+		t.Errorf("physical drift was not repaired: brightness = %q, want \"0\"", got)
+	}
+}
