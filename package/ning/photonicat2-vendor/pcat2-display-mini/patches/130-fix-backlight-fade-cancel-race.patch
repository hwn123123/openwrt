+// setFadeBacklight writes one fade step only while cancelChan is still the
+// active transition.  Keeping fadeMu locked across the validation and write
+// makes cancellation a barrier: once a state transition closes/replaces the
+// channel, the old fade can no longer overwrite the new state's brightness.
+func setFadeBacklight(cancelChan chan struct{}, brightness int) bool {
+	fadeMu.Lock()
+	defer fadeMu.Unlock()
+
+	if cancelChan != fadeCancel {
+		return false
+	}
+	select {
+	case <-cancelChan:
+		return false
+	default:
+		setBacklight(brightness)
+		return true
+	}
+}
