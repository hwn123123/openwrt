+type smsEventResponse struct {
+	Version int64 `json:"version"`
+	Changed bool  `json:"changed"`
+}
+
+func watchSmsDatabaseEvents() {
+	client := &http.Client{Timeout: 65 * time.Second}
+	var since int64
+	connected := false
+	failureLogged := false
+	for {
+		url := fmt.Sprintf(
+			"http://127.0.0.1:8092/v1/sms/events?since=%d&timeout=55", since)
+		resp, err := client.Get(url)
+		if err != nil {
+			if !failureLogged {
+				log.Printf("SMS event listener unavailable: %v", err)
+				failureLogged = true
+			}
+			connected = false
+			time.Sleep(5 * time.Second)
+			continue
+		}
+		body, readErr := io.ReadAll(io.LimitReader(resp.Body, 4096))
+		resp.Body.Close()
+		var event smsEventResponse
+		if resp.StatusCode != http.StatusOK || readErr != nil ||
+			secureUnmarshal(body, &event) != nil || event.Version <= 0 {
+			if !failureLogged {
+				log.Printf("SMS event listener received an invalid response")
+				failureLogged = true
+			}
+			connected = false
+			time.Sleep(5 * time.Second)
+			continue
+		}
+
+		// Signal once on initial connection/recovery so startup cannot miss a
+		// database change that happened while the sidecar was unavailable.
+		if !connected || event.Changed {
+			select {
+			case smsDatabaseSignal <- struct{}{}:
+			default:
+			}
+		}
+		connected = true
+		failureLogged = false
+		since = event.Version
+	}
+}
