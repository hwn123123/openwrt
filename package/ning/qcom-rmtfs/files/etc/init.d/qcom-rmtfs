#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause

START=08
STOP=92
USE_PROCD=1

prepare_uio_alias() {
	local uio name
	[ -e /dev/qcom_rmtfs_mem1 ] && return 0
	[ -e /dev/qcom_rmtfs_uio1 ] && return 0
	for uio in /sys/class/uio/uio*; do
		[ -r "$uio/name" ] || continue
		name="$(cat "$uio/name" 2>/dev/null)"
		[ "$name" = rmtfs ] || continue
		[ -e "/dev/${uio##*/}" ] || continue
		ln -sfn "/dev/${uio##*/}" /dev/qcom_rmtfs_uio1
		return 0
	done
	return 1
}

start_service() {
	local read_only
	prepare_uio_alias || logger -t qcom-rmtfs "rmtfs shared-memory device is not ready"
	read_only="$(uci -q get xm14cellular.main.rmtfs_read_only)"

	procd_open_instance
	procd_set_param command /usr/bin/rmtfs -P -o /dev/block/by-name
	[ "$read_only" = 0 ] || procd_append_param command -r
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xm14cellular
}
