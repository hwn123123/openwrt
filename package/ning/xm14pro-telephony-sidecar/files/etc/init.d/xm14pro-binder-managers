#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
# The Binder devices and their three stock managers are the root of the whole
# Android radio sidecar.  They must exist before PeripheralManager, QCRIL or
# NICM is allowed to start.
START=57
STOP=43

ANDROID_ROOT=/usr/libexec/xm14pro-qwes/android-root
LAUNCHER=/usr/libexec/xm14pro-telephony/launcher

bind_once() {
	local source="$1"
	local target="$2"

	grep -Fqs " $target " /proc/mounts && return 0
	mkdir -p "$source" "$target" || return 1
	mount -o bind "$source" "$target"
}

prepare_binder_link() {
	local link="$1"
	local target="$2"

	if [ -L "$link" ]; then
		[ "$(readlink "$link")" = "$target" ] || return 1
	elif [ -e "$link" ]; then
		return 1
	else
		ln -s "$target" "$link" || return 1
	fi
}

prepare_binder_nodes() {
	local name

	mkdir -p /dev/binderfs || return 1
	grep -Fqs ' /dev/binderfs ' /proc/mounts ||
		mount -t binder binder /dev/binderfs || return 1
	for name in binder hwbinder vndbinder; do
		[ -c "/dev/binderfs/$name" ] || return 1
		chown 0:0 "/dev/binderfs/$name" || return 1
		chmod 0666 "/dev/binderfs/$name" || return 1
		prepare_binder_link "/dev/$name" "/dev/binderfs/$name" ||
			return 1
	done
}

add_instance() {
	local name="$1"

	procd_open_instance "$name"
	procd_set_param command "$LAUNCHER" "$ANDROID_ROOT" "$name"
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local enabled

	config_load xm14telephony
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	/etc/init.d/xm14pro-qwes running || /etc/init.d/xm14pro-qwes start
	prepare_binder_nodes || {
		logger -t xm14pro-binder 'failed to prepare the three BinderFS devices'
		return 1
	}
	# xm14pro-qseecomd binds the top-level /dev before BinderFS is mounted.
	# That non-recursive bind does not propagate the later BinderFS submount,
	# so /dev/binder inside the chroot points at an absent target.  Establish
	# the complete compatibility-root mounts here before any manager is execed.
	bind_once /dev "$ANDROID_ROOT/dev" || {
		logger -t xm14pro-binder 'failed to bind /dev into Android root'
		return 1
	}
	bind_once /dev/binderfs "$ANDROID_ROOT/dev/binderfs" || {
		logger -t xm14pro-binder 'failed to bind BinderFS into Android root'
		return 1
	}
	bind_once /proc "$ANDROID_ROOT/proc" || {
		logger -t xm14pro-binder 'failed to bind /proc into Android root'
		return 1
	}
	bind_once /sys "$ANDROID_ROOT/sys" || {
		logger -t xm14pro-binder 'failed to bind /sys into Android root'
		return 1
	}
	# selinuxfs is an independent Android mount. A normal /sys bind does not
	# include it, and vndservicemanager aborts without its status node.
	bind_once /sys/fs/selinux "$ANDROID_ROOT/sys/fs/selinux" || {
		logger -t xm14pro-binder 'failed to bind selinuxfs into Android root'
		return 1
	}

	# The stock telephony stack spans framework, hardware and vendor Binder.
	add_instance servicemanager
	add_instance hwservicemanager
	add_instance vndservicemanager
}

service_triggers() {
	procd_add_reload_trigger xm14telephony
}
