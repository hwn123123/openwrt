#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
# HyperOS starts the real SystemSuspend service as an early HAL before radio.
# Keep it independent from QCRIL so the platform Binder service is registered
# before NICM, the cellular controller and the radio sidecar are released.
START=60
STOP=41

ANDROID_ROOT=/usr/libexec/xm14pro-qwes/android-root
LAUNCHER=/usr/libexec/xm14pro-telephony/launcher

manager_running() {
	local command="$1"

	ps w | awk -v command="$command" '
		index($0, command) && $0 !~ /awk -v command=/ { found = 1 }
		END { exit found ? 0 : 1 }
	'
}

wait_for_binder_manager() {
	local attempt=0

	while [ "$attempt" -lt 15 ]; do
		if [ -c /dev/binder ] && manager_running '/system/bin/servicemanager'; then
			sleep 1
			[ -c /dev/binder ] && manager_running '/system/bin/servicemanager'
			return $?
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

prepare_suspend_nodes() {
	# Exact stock OS3.0.308.0 init.rc setup. wakeup_count intentionally keeps
	# the kernel-provided 0644 mode; ownership gives the system service read
	# access, while state is the only node made group-writable by stock init.
	[ -e /sys/power/state ] && [ -e /sys/power/wakeup_count ] || return 1
	chown 1000:1000 /sys/power/state /sys/power/wakeup_count || return 1
	chmod 0660 /sys/power/state || return 1
}

start_service() {
	local enabled

	config_load xm14telephony
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	wait_for_binder_manager || {
		logger -t xm14pro-system-suspend 'framework Binder manager failed to become ready'
		return 1
	}
	prepare_suspend_nodes || {
		logger -t xm14pro-system-suspend 'failed to apply stock power-node ownership'
		return 1
	}

	procd_open_instance system-suspend
	procd_set_param command "$LAUNCHER" "$ANDROID_ROOT" system-suspend
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xm14telephony
}
