#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
START=59
STOP=41

ANDROID_ROOT=/usr/libexec/xm14pro-qwes/android-root
LAUNCHER=/usr/libexec/xm14pro-telephony/launcher

manager_running() {
	local command="$1"

	ps w | awk -v command="$command" '
		index($0, command) && $0 !~ /awk -v command=/ { found = 1 }
		END { exit found ? 0 : 1 }
	'
}

wait_for_peripheral_manager() {
	local attempt=0

	while [ "$attempt" -lt 15 ]; do
		if manager_running '/vendor/bin/pm-service'; then
			# Match Android's per_mgr=running trigger only after the process has
			# survived a complete scheduler interval.
			sleep 1
			manager_running '/vendor/bin/pm-service'
			return $?
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

start_service() {
	local enabled

	config_load xm14telephony
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	wait_for_peripheral_manager || {
		logger -t xm14pro-peripheral 'pm-service failed to become ready'
		return 1
	}

	procd_open_instance pm-proxy
	procd_set_param command "$LAUNCHER" "$ANDROID_ROOT" pm-proxy
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xm14telephony
}
