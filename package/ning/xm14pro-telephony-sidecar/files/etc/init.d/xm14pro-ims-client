#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
# S64 starts QCRIL/IMS and S65 establishes the persistent standard Radio
# callbacks. Only after that real framework boundary may the persistent IMS
# owner attach both slots and mirror HyperOS' active-slot enable sequence. It
# never creates or modifies a data session.
START=66
STOP=39

start_service() {
	local enabled

	config_load xm14telephony
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance ims-client
	procd_set_param command /usr/libexec/xm14pro-telephony/ims-bridge
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xm14telephony
}
